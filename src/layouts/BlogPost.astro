---
// 文章內頁（v2 暖光放映廳）：深色開場（場記板標籤）→ 淺紙內文（長文閱讀優先）＋右側黏性目錄
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import { SITE_TITLE, SITE_URL, CTA_BOOKING_URL } from '../consts';
import { dotDate } from '../utils/post-meta';
import '../styles/v2.css';
import '../styles/v2-post.css';

type NavLink = { slug: string; title: string } | null;
type Heading = { depth: number; slug: string; text: string };
type Props = CollectionEntry<'blog'>['data'] & {
  newer?: NavLink;
  older?: NavLink;
  headings?: Heading[];
  category?: string;
  readingMinutes?: number;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  newer = null,
  older = null,
  headings = [],
  category = '職涯',
  readingMinutes = 5,
} = Astro.props;

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';

// 文章 OG 圖：有 heroImage 用之，否則 fallback 到預設 OG
const ogImage = heroImage ? `${SITE_URL}${heroImage}` : '/og-default.png';
const hasToc = headings.length > 0;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO
      title={`${title} ｜ ${SITE_TITLE}`}
      description={description}
      type="article"
      publishDate={pubDate}
      modifiedDate={updatedDate}
      image={heroImage ? ogImage : undefined}
    />
    <style is:global>
      html { scroll-behavior: smooth; scroll-padding-top: 96px; }
    </style>
  </head>
  <body class="pv post-page">
    <V2Nav chatHref={FREE_CHAT_URL} hall="NOW READING" />

    <!-- ================= 開場：文章頭 ================= -->
    <header class="dark grain post-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="wrap post-hero-in">
        <a class="back-link" href="/blog">← 所有文章</a>

        <div class="slate" aria-label="文章資訊">
          <div class="slate-sticks" aria-hidden="true"></div>
          <dl class="slate-board">
            <div><dt>SCENE</dt><dd><a href={`/blog#cat-${category}`}>{category}</a></dd></div>
            <div><dt>DATE</dt><dd><time datetime={pubDate.toISOString()}>{dotDate(pubDate)}</time></dd></div>
            <div><dt>RUNTIME</dt><dd>閱讀 {readingMinutes} 分鐘</dd></div>
            <div><dt>DIRECTOR</dt><dd>Dex</dd></div>
          </dl>
        </div>

        <div class="post-kicker">A LETTER FROM DEX</div>
        <h1 class="post-title">{title}</h1>
        <p class="post-desc">{description}</p>
        {updatedDate && (
          <p class="post-updated">更新於 <time datetime={updatedDate.toISOString()}>{dotDate(updatedDate)}</time></p>
        )}
      </div>
    </header>
    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= 內文 ================= -->
    <main class="paper post-body">
      <div class={`wrap post-layout ${hasToc ? 'has-toc' : ''}`}>
        <article class="post-article">
          {heroImage && (
            <figure class="post-cover">
              <img src={heroImage} alt={title} loading="eager" />
            </figure>
          )}

          <!-- 開頭 — ROLLING CTA（電影開拍 vibe） -->
          <aside class="rolling" aria-label="訂閱電子報">
            <div class="rolling-copy">
              <div class="rolling-k"><span class="rec" aria-hidden="true"></span>ROLLING · 開拍</div>
              <div class="rolling-t">先訂閱電子報 — 每兩週收到一封 Dex 的塵世筆記</div>
            </div>
            <a class="btn btn-cta" href="/newsletter">免費領取 →</a>
          </aside>

          {hasToc && (
            <details class="toc-inline">
              <summary>目錄 · {headings.length} 段</summary>
              <ul>
                {headings.map((h) => (
                  <li class={`toc-d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ul>
            </details>
          )}

          <div class="post-prose">
            <slot />
          </div>

          <!-- 文章尾 — CTA 區 -->
          <section class="post-end dark grain" aria-label="讀完之後">
            <div class="post-end-k">THE END · 謝謝你讀完</div>
            <h2>如果你也正在這條路上</h2>
            <p>我每兩週寫一封信給你，聊聊程式、職涯與 AI。也歡迎預約 1:1 諮詢，50 分鐘陪你想清楚。</p>
            <div class="post-end-actions">
              <a class="btn btn-amber" href="/newsletter">免費領取電子報 →</a>
              <a class="btn btn-line" href={CTA_BOOKING_URL} target="_blank" rel="noopener noreferrer">預約諮詢</a>
              <a class="btn btn-line" href="/about">認識 Dex</a>
            </div>
          </section>

          <!-- 上下篇導覽 -->
          {(newer || older) && (
            <nav class="post-nav" aria-label="文章導覽">
              {newer ? (
                <a class="post-nav-card" href={`/blog/${newer.slug}`} rel="prev">
                  <span class="post-nav-k">← 上一篇（較新）</span>
                  <span class="post-nav-t">{newer.title}</span>
                </a>
              ) : <span></span>}
              {older ? (
                <a class="post-nav-card is-next" href={`/blog/${older.slug}`} rel="next">
                  <span class="post-nav-k">下一篇（較舊）→</span>
                  <span class="post-nav-t">{older.title}</span>
                </a>
              ) : <span></span>}
            </nav>
          )}
        </article>

        {hasToc && (
          <aside class="toc-sidebar" aria-label="文章目錄">
            <div class="toc-title">SCENES · 目錄</div>
            <ul class="toc-list">
              {headings.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class={`toc-link toc-h${h.depth}`} data-slug={h.slug}>{h.text}</a>
                </li>
              ))}
            </ul>
          </aside>
        )}
      </div>
    </main>

    <V2Footer />
    <NewsletterFloatingCTA />

    <script is:inline>
      // 表格包一層可橫向捲動的容器（手機不撐破版面）
      document.querySelectorAll('.post-prose table').forEach(function (t) {
        if (t.parentElement && t.parentElement.classList.contains('table-wrap')) return;
        var w = document.createElement('div');
        w.className = 'table-wrap';
        t.parentNode.insertBefore(w, t);
        w.appendChild(t);
      });

      // TOC：捲動時高亮目前段落（取「已捲過頁首下緣」的最後一個標題）
      (function () {
        var links = Array.prototype.slice.call(document.querySelectorAll('.toc-link'));
        if (!links.length) return;
        var heads = links
          .map(function (a) { return document.getElementById(a.getAttribute('data-slug') || ''); })
          .filter(Boolean);
        var current = '';
        function offset() {
          var nav = document.querySelector('.pv .nav');
          return (nav ? nav.getBoundingClientRect().height : 0) + 48;
        }
        function update() {
          var line = offset();
          var slug = heads.length ? heads[0].id : '';
          for (var i = 0; i < heads.length; i++) {
            if (heads[i].getBoundingClientRect().top <= line) slug = heads[i].id; else break;
          }
          if (slug === current) return;
          current = slug;
          links.forEach(function (l) {
            var on = l.getAttribute('data-slug') === slug;
            l.classList.toggle('is-active', on);
            if (on) {
              l.setAttribute('aria-current', 'location');
              var box = l.closest('.toc-sidebar');
              if (box) {
                var lt = l.offsetTop, bh = box.clientHeight;
                if (lt < box.scrollTop || lt > box.scrollTop + bh - 40) box.scrollTop = lt - bh / 3;
              }
            } else l.removeAttribute('aria-current');
          });
        }
        var ticking = false;
        window.addEventListener('scroll', function () {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(function () { ticking = false; update(); });
        }, { passive: true });
        window.addEventListener('resize', update);
        update();
      })();
    </script>
  </body>
</html>
