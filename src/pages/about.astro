---
// 關於我（v2 暖光放映廳風格）— 原頁文字、CTA、SEO 全數保留，只換外觀與修正事實
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import {
  SITE_TITLE,
  CTA_BOOKING_URL,
  CTA_COURSE_URL,
  CTA_COURSE_DISCOUNT_CODE,
} from '../consts';
import '../styles/v2.css';
import '../styles/v2-about.css';

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';
const CONTACT_EMAIL = 'daydreamisexp@gmail.com'; // Dex 指定：全站對外信箱一律用這個

// SEO
const aboutTitle = `關於我 ｜ ${SITE_TITLE}`;
const aboutDescription =
  'Dex（盧冠宏），Dex 的塵世哲學主理人。AI 技術總監 × 轉職陪跑教練，10 年跨界 4 種專業，從半導體到資料工程、軟體、AI。50+ 轉職學員指導、320+ 電子報訂閱、3,962+ Threads 追蹤 — 陪你想清楚下一步。';

// 職涯時間軸（電影膠片）— 對齊 facts.md 第 6 區
const careerTimeline = [
  { period: '2016 — 2019', company: '台灣美光', role: 'Defect Analyst Engineer', desc: '半導體製程，跨界的起點。', sceneNo: '01' },
  { period: '2019 — 2021', company: 'TutorABC', role: 'Big Data Engineer', desc: '走進資料工程的第一站。', sceneNo: '02' },
  { period: '2021', company: 'LINE Bank', role: 'Data Engineer', desc: '金融級資料管線實戰。', sceneNo: '03' },
  { period: '2021 — 2025', company: '緯創資通', role: 'Data Engineer & Back-End Developer', desc: '資料工程 × 後端 × ESG 全球工廠數據平台。', sceneNo: '04' },
  { period: '2025 — 2026', company: '水球軟體學院', role: '行銷與技術雙棲（正職）', desc: '從技術走進品牌與成長 — 1 月百萬營收實戰。', sceneNo: '05' },
  { period: '2026 — Now', company: 'Hamastar Tech', role: 'AI 技術總監', desc: '帶領 AI 開發，做想做的事。', sceneNo: '06', highlight: true },
];

// 兼任 / 業師 / 教練合作（依 facts.md 7b + 8 區）
const sideRoles = [
  'TibaMe 雲端資料工程在職班 專題業師（2026 –）',
  'AAPD 擺渡職涯 職涯陪跑教練（2026 –）',
  '學米 大數據與資料分析職涯業師（2023 –）',
  '六角學院 後端課程 專題教練（2023 –）',
  'nschool 職能學院 AI 與大數據業師（2023 –）',
  '無限學院 資料工程學習總監（2024 –）',
  'Podcaster：沒走歪的才奇怪',
];

// 教練風格 4 大特色
const coachingStyles = [
  { title: '結構化引導', desc: '把模糊的問題拆成可理解的步驟，讓你看得見全貌、走得出第一步。', icon: 'compass' },
  { title: '為什麼而學', desc: '不只教技術，更聚焦目標與應用情境 —— 讓每一份學習，都有理由。', icon: 'target' },
  { title: '技術 × 職涯 × 生涯', desc: '把能力，轉成職涯與生涯機會 —— 不只活下來，是活成你想要的樣子。', icon: 'lightbulb' },
  { title: '明確下一步行動', desc: '每次對談都帶走可執行的 next action 。不畫大餅，談的是這週怎麼動。', icon: 'send' },
];

// 5 大痛點
const painPoints = [
  { problem: '想轉職，但不確定路徑', solution: '釐清「目標 × 學習路徑 × 職涯策略」' },
  { problem: '想做作品集，但不知道從哪做起', solution: '從「情境 → 技術 → 專題」建立方向' },
  { problem: '學了技術，卻無法轉成職場能力', solution: '整合成「企業看得懂的作品集與經驗」' },
  { problem: '履歷投了沒回應', solution: '從「作品集 × 履歷 × 求職策略」找斷點' },
  { problem: '技術學習卡關', solution: '從「應用情境 × 整體脈絡」理解技術如何被使用' },
];

// 鏡頭外（螢幕之外的 Dex）
const offSet = [
  { icon: 'movie', k: '看電影', v: '昆丁塔倫提諾、大智若魚、我的完美日常' },
  { icon: 'music', k: '聽音樂', v: '落日飛車、Deca joins、無妄合作社' },
  { icon: 'mic', k: '聽 Podcast', v: '只能喝酒的圖書館、台灣通勤第一品牌' },
  { icon: 'car', k: '跨界冒險', v: '5 天 4 夜開露營車環島北海道' },
];

// 興趣（OFF DUTY 三張票）
const interests = [
  { en: 'MOVIES', zh: '電影', icon: 'movie', items: ['昆汀塔倫提諾', '大智若魚', '我的完美日常'] },
  { en: 'MUSIC', zh: '音樂', icon: 'music', items: ['落日飛車', 'Deca joins', '無妄合作社'] },
  { en: 'PODCAST', zh: 'Podcast', icon: 'headphone', items: ['只能喝酒的圖書館', '台灣通勤第一品牌'] },
];

// 成就解鎖（片尾名單 CREDITS）
const credits = [
  {
    role: 'CAREER SWITCH',
    title: '跨界轉職',
    items: [
      '半導體 QA → Big Data Engineer（人生第一次跨界）',
      '工程師 → 成長行銷顧問（橫向跨界，少見路徑）',
      '跨界 4 種專業 10 年（半導體 → 大數據 → 軟體 → AI）',
    ],
  },
  {
    role: 'TEACHING & COACHING',
    title: '教學陪跑',
    items: [
      'Tibame 雲端資料工程師線上班 講師 + 專題導師',
      '緯創資通數據工程學院 內訓講師（資料治理 / DataOps）',
      'CDA 職涯諮詢師 / AndAction Life Coach 認證',
      'Alpha Camp / 六角學院 / 學米 / 無限學院 業師',
    ],
  },
  {
    role: 'CONTENT',
    title: '內容創作',
    items: ['Podcaster「沒走歪的才奇怪」上線 Spotify', 'Dex 的塵世哲學部落格 — 寫給每個還在路上的工程師'],
  },
  {
    role: 'ADVENTURE',
    title: '人生冒險',
    items: ['5 天 4 夜開露營車環島北海道', '從單一工程師 → 教練 × 講師 × 創作者 混合身份'],
  },
];
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={aboutTitle} description={aboutDescription} type="website" />
  </head>
  <body class="pv about-v2">
    <V2Nav chatHref={FREE_CHAT_URL} hall="HALL 02" />

    <!-- ================= HERO：角色介紹 ================= -->
    <header class="dark grain ab-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <svg class="cam-watermark" width="560" height="560" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="none" stroke="#F3EBDD" stroke-width="0.35" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="6" r="3.2" /><circle cx="9" cy="6" r="0.9" />
          <circle cx="17" cy="6" r="3.2" /><circle cx="17" cy="6" r="0.9" />
          <path d="M9 9.2v2M17 9.2v2" /><rect x="3" y="11" width="18" height="11" rx="1.4" />
          <circle cx="12" cy="16.5" r="3" />
        </g>
      </svg>

      <div class="wrap ab-hero-grid">
        <div>
          <div class="ab-kicker">ABOUT · SCENE 03 · <span>角色介紹</span></div>
          <h1 class="ab-h1">一個從<em>半導體</em>跨到 <em>AI</em> 的<br />長期主義者。</h1>
          <p class="ab-lead">
            我是 Dex，Dex 的塵世哲學創辦人。轉職顧問 × AI 技術總監，10 年跨界 4 種專業，從半導體到資料工程、軟體、AI。
          </p>
          <p class="ab-lead-sub">輔導學員打造作品集、撰寫履歷、規劃職涯 —— 陪你達到軟體和資料職涯目標。</p>

          <div class="ctas">
            <a class="btn btn-amber" href={CTA_BOOKING_URL} target="_blank" rel="noopener noreferrer">
              <Icon name="pixelarticons:calendar" width={16} height={16} />預約一場諮詢
            </a>
            <a class="btn btn-line" href={`mailto:${CONTACT_EMAIL}`}>
              <Icon name="pixelarticons:mail" width={16} height={16} />寫封信給我
            </a>
            <span class="aside">· 50 分鐘，不催促</span>
          </div>
        </div>

        <div class="hero-visual ab-visual">
          <div class="film-frame">
            <picture>
              <source type="image/avif" srcset="/photos/dex-portrait-1-640.avif" />
              <img src="/photos/dex-portrait-1-640.webp" alt="Dex" width="340" height="340" loading="eager" fetchpriority="high" />
            </picture>
            <span class="ab-frame-cap">DAYDREAM · DEX</span>
          </div>
          <div class="card ab-card-years">
            <span class="ab-dot" aria-hidden="true"></span>
            <div><b>跨界 10 年</b><small>4 種專業 · 還在路上</small></div>
          </div>
          <div class="card card-chair">
            <Icon name="pixelarticons:send" width={18} height={18} />
            <div><b>諮詢開放預約中</b><small>不勉強，有需要再來</small></div>
          </div>
        </div>
      </div>
    </header>

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= MY STORY ================= -->
    <section class="paper ab-story">
      <div class="wrap narrow">
        <div class="ab-tag">MY STORY</div>
        <h2 class="ab-h2">我的故事</h2>
        <div class="ab-story-body">
          <p>6 年多前我從<b>半導體設備工程師</b>轉職，經歷大數據、軟體後端開發，到現在成為 <b>AI 技術總監</b>，帶領 AI 技術開發。</p>
          <p>這段過程讓我理解「<span class="mark">學習技術</span>」到「<span class="mark">進入職場</span>」之間的落差，因此我開始投入職涯輔導，協助作品集指導、專題陪跑與轉職策略 —— 把能力轉化為具體成果與職場價值。</p>
          <p>過去曾在 Alpha Camp、六角學院、學米等協助學員成長，也是緯育「雲端資料工程師線上班」的課程講師與專題導師。</p>
          <p>因為自己的親身經歷，我了解在不同階段會遇到的迷惘。我會陪伴在各種層面卡關的人 —— 無論是學習方向、作品集、斜槓專案或求職轉職問題 —— 一起把問題釐清、整合技能，<b>逐步走出一條清晰可行的路</b>。</p>
        </div>
      </div>
    </section>

    <!-- ================= REEL：職涯時間軸 ================= -->
    <section class="dark grain ab-reel-sec">
      <div class="wrap">
        <div class="ab-reel-head">
          <div>
            <div class="ab-tag">REEL A · TIMELINE · <span>跨界 10 年</span></div>
            <h2 class="ab-h2">從半導體到 AI，我走過的這條路</h2>
            <p class="sub">6 家公司、4 種專業 —— 每一段都不是速成，但都教了我一些關鍵的事。每一格都是一場戲。</p>
          </div>
          <div class="ab-clapper" aria-hidden="true">
            <svg width="150" height="112" viewBox="0 0 200 150">
              <rect x="6" y="0" width="188" height="36" rx="3" fill="#F3EBDD" />
              {Array.from({ length: 8 }).map((_, i) => (
                <polygon points={`${10 + i * 24},2 ${28 + i * 24},2 ${22 + i * 24},34 ${4 + i * 24},34`} fill="#16100C" />
              ))}
              <rect x="6" y="42" width="188" height="100" rx="3" fill="#F3EBDD" />
              <g fill="#16100C" font-family="'Noto Sans TC','PingFang TC',sans-serif">
                <text x="20" y="70" font-size="10" opacity="0.6" letter-spacing="1">SCENE</text>
                <text x="20" y="100" font-size="22" font-weight="800">CAREER</text>
                <text x="20" y="124" font-size="10" opacity="0.6" letter-spacing="1">DIRECTOR · DEX</text>
              </g>
            </svg>
          </div>
        </div>

        <div class="ab-reel" tabindex="0" aria-label="職涯膠捲，可左右捲動">
          <ol class="ab-reel-track">
            {careerTimeline.map((row) => (
              <li class={`ab-frame ${row.highlight ? 'is-now' : ''}`}>
                <div class="ab-frame-top">
                  <span class="ab-scene-no">SCENE {row.sceneNo}</span>
                  {row.highlight && <span class="ab-now">NOW</span>}
                  <b class="ab-company">{row.company}</b>
                </div>
                <div class="ab-frame-body">
                  <span class="ab-period">{row.period}</span>
                  <h3>{row.role}</h3>
                  <p>{row.desc}</p>
                </div>
                <span class="ab-frame-no">{row.sceneNo} / 06</span>
              </li>
            ))}
          </ol>
        </div>
        <div class="ab-reel-foot">
          <span>ROLL · A · 2016 ~ 2026 · 6 SCENES</span>
          <span class="ab-swipe">← 橫向滑動 →</span>
        </div>
      </div>
    </section>

    <!-- ================= OFF SET + 斜槓身份 ================= -->
    <section class="paper sec ab-offset">
      <div class="wrap ab-offset-grid">
        <div class="ab-offset-card">
          <div class="ab-offset-head">
            <div>
              <span class="ab-chip"><Icon name="pixelarticons:video" width={14} height={14} />鏡頭外</span>
              <div class="ab-tag">OFF SET</div>
              <h3>螢幕之外的 Dex</h3>
            </div>
            <div class="ab-polaroid">
              <img src="/photos/dex-portrait-2.png" alt="Dex" loading="lazy" width="120" height="120" />
            </div>
          </div>
          <ul class="ab-offset-list">
            {offSet.map((o) => (
              <li>
                <span class="ab-ico" aria-hidden="true"><Icon name={`pixelarticons:${o.icon}`} width={20} height={20} /></span>
                <span><b>{o.k}</b>{o.v}</span>
              </li>
            ))}
          </ul>
          <p class="ab-note">工程師也需要離開螢幕，才看得清楚自己要去哪裡。</p>
        </div>

        <div class="ab-side">
          <div class="case-sheet"><span>CAST LIST</span><span>斜槓身份</span></div>
          <h3>主業之外，我也在做這些事</h3>
          <ul class="ab-side-list">
            {sideRoles.map((role) => (
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B45309" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg>
                {role}
              </li>
            ))}
          </ul>
          <p class="ab-note">不是斜槓焦慮 —— 是因為「教別人」就是把自己學過的路再走一次。</p>
        </div>
      </div>
    </section>

    <!-- ================= COACHING STYLE ================= -->
    <section class="dark grain ab-coach">
      <div class="wrap">
        <div class="ab-tag">COACHING STYLE</div>
        <h2 class="ab-h2">我陪你走的方式</h2>
        <p class="sub">不是給你標準答案 —— 是幫你問對問題，找到屬於你的下一步。</p>
        <div class="ab-coach-grid">
          {coachingStyles.map((s, i) => (
            <div class="ab-coach-card">
              <div class="act-strip" aria-hidden="true"></div>
              <div class="ab-coach-top">
                <span class="ab-take">TAKE 0{i + 1}</span>
                <span class="ab-coach-ico" aria-hidden="true"><Icon name={`pixelarticons:${s.icon}`} width={26} height={26} /></span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FOR WHOM：5 大痛點 ================= -->
    <section class="paper sec ab-whom">
      <div class="wrap">
        <div class="ab-tag">FOR WHOM</div>
        <h2 class="ab-h2">如果你正在這些卡關的時刻</h2>
        <p class="sub">我懂這些迷惘 —— 因為我自己都走過。</p>
        <div class="ab-pain-sheet">
          <div class="case-sheet"><span>CALL SHEET · 卡關清單</span><span>05 SCENES</span></div>
          <ol class="ab-pain-list">
            {painPoints.map((p, i) => (
              <li>
                <span class="ab-pain-no">0{i + 1}</span>
                <div>
                  <span class="ab-pain-k">痛點</span>
                  <b>{p.problem}</b>
                </div>
                <div class="ab-pain-sol">
                  <span class="ab-pain-k is-warm">解方</span>
                  <span>{p.solution}</span>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- ================= SCENE 04 · 信念 ================= -->
    <section class="dark grain ab-belief">
      <div class="wrap narrow">
        <div class="final-scene ab-belief-card">
          <span class="final-tag">SCENE 04 · 信念</span>
          <div class="ab-film-src">《心靈捕手》Good Will Hunting · 1997</div>
          <div class="scene-line">“Now you can know everything in the world, but the only way you're finding out that one is by giving it a shot.”</div>
          <div class="scene-sub">—— 你可以讀遍世界所有的書，但要知道某一件事到底是怎麼回事，唯一的方法，是去試試看。</div>
        </div>
      </div>
    </section>

    <!-- ================= OFF DUTY：興趣 ================= -->
    <section class="paper sec ab-duty">
      <div class="wrap">
        <div class="ab-tag">OFF DUTY</div>
        <h2 class="ab-h2">不寫程式的時候，我在這裡</h2>
        <p class="sub">部落格寫的是工程師的事，但我也是一個會看電影、會聽歌、會在 Podcast 裡笑出聲的人。</p>
        <div class="ab-ticket-grid">
          {interests.map((t, i) => (
            <div class="ab-ticket">
              <div class="ab-ticket-stub">
                <span>ADMIT ONE</span>
                <span>No. {String(i + 1).padStart(3, '0')}</span>
              </div>
              <div class="ab-ticket-main">
                <div class="ab-ticket-head">
                  <span class="ab-ico" aria-hidden="true"><Icon name={`pixelarticons:${t.icon}`} width={22} height={22} /></span>
                  <div><small>{t.en}</small><b>{t.zh}</b></div>
                </div>
                <ul>{t.items.map((m) => <li>{m}</li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= CREDITS：成就解鎖 ================= -->
    <section class="dark grain ab-credits">
      <div class="wrap narrow">
        <div class="ab-credits-badge"><Icon name="pixelarticons:trophy" width={16} height={16} />ACHIEVEMENTS</div>
        <h2 class="ab-h2 center">成就解鎖</h2>
        <p class="sub center">十年跨界，不是衝刺、不是規劃完美，是一段又一段真實走過的路。</p>
        <div class="ab-credits-roll">
          <div class="ab-credits-title">— END CREDITS —</div>
          {credits.map((c) => (
            <div class="ab-credit">
              <div class="ab-credit-role">{c.role}</div>
              <h3>{c.title}</h3>
              <ul>{c.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
          <p class="ab-credits-end">
            <Icon name="pixelarticons:send" width={16} height={16} />在路上，比抵達更重要。
          </p>
        </div>
      </div>
    </section>

    <!-- ================= CTA ================= -->
    <section class="paper sec ab-cta">
      <div class="wrap">
        <div class="case-grid">
          <article class="case">
            <span class="tape tape-l" aria-hidden="true"></span>
            <span class="tape tape-r" aria-hidden="true"></span>
            <div class="case-sheet"><span>AAPD 教練陪跑</span><span>1:1</span></div>
            <span class="ab-cta-ico" aria-hidden="true"><Icon name="pixelarticons:lightbulb" width={24} height={24} /></span>
            <h3>1:1 諮詢 — 我陪你想清楚</h3>
