---
// 文章列表（v2 暖光放映廳）：深色開場＋最新一篇 → 精選五篇 → 所有的塵世筆記（分類篩選）
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SEO from '../../components/SEO.astro';
import NewsletterFloatingCTA from '../../components/blocks/NewsletterFloatingCTA.astro';
import V2Nav from '../../components/v2/V2Nav.astro';
import V2Footer from '../../components/v2/V2Footer.astro';
import { SITE_TITLE, FEATURED_POST_SLUGS } from '../../consts';
import { POST_CATS, inferTag, readingMinutes, dotDate } from '../../utils/post-meta';
import '../../styles/v2.css';
import '../../styles/v2-blog.css';

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';

const entries = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const pad = (n: number) => String(n).padStart(2, '0');
const posts = entries.map((p) => {
  const d = p.data.pubDate;
  return {
    id: p.id,
    title: p.data.title,
    desc: p.data.description,
    heroImage: p.data.heroImage,
    pubDate: d,
    tag: inferTag(p.data.title, p.data.description),
    minutes: readingMinutes(p.body),
    date: `${pad(d.getMonth() + 1)} / ${pad(d.getDate())}`,
    year: String(d.getFullYear()),
  };
});

const totalPosts = posts.length;
const [latest] = posts;

// 分類：首頁同一套四類；若有落在「職涯」的文章也給它一顆按鈕
const cats = [...POST_CATS, ...(posts.some((p) => p.tag === '職涯') ? ['職涯'] : [])];
const catCount = Object.fromEntries(cats.map((c) => [c, posts.filter((p) => p.tag === c).length]));

const featured = FEATURED_POST_SLUGS.map((slug) => posts.find((p) => p.id.includes(slug))).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

const blogTitle = `所有文章 ｜ ${SITE_TITLE}`;
const blogDescription = 'Dex 的塵世筆記 —— 軟體、資料工程、AI、轉職、跨界的長思考。慢慢看，我們有的是時間。';
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={blogTitle} description={blogDescription} type="website" />
  </head>
  <body class="pv">
    <V2Nav chatHref={FREE_CHAT_URL} hall="HALL 06" />

    <!-- ================= 開場 + 最新一篇 ================= -->
    <header class="dark grain blog-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap blog-hero-grid">
        <div>
          <div class="scene-chip"><span class="rec" aria-hidden="true"></span>SCENE · ARCHIVE</div>
          <h1 class="page-h1">所有文章</h1>
          <p class="blog-lead">{blogDescription}</p>
          <div class="blog-count">
            <span><b>{totalPosts}</b> 篇長文</span>
            <span><b>{cats.length}</b> 個分類</span>
            <span>慢慢讀，不必急</span>
          </div>
        </div>

        {latest && (
          <a class="latest" href={`/blog/${latest.id}`}>
            <div class="latest-top"><span>NOW SHOWING · 最新一篇</span><span>{latest.tag}</span></div>
            {latest.heroImage ? (
              <div class="latest-img"><img src={latest.heroImage} alt={latest.title} loading="eager" /></div>
            ) : (
              <div class="latest-img latest-img-empty" aria-hidden="true"><span>DAYDREAM · DEX</span></div>
            )}
            <h2>{latest.title}</h2>
            <p>{latest.desc}</p>
            <div class="latest-meta">
              <time datetime={latest.pubDate.toISOString()}>{dotDate(latest.pubDate)}</time>
              <span>閱讀 {latest.minutes} 分鐘</span>
              <span class="latest-go">閱讀全文 →</span>
            </div>
          </a>
        )}
      </div>
    </header>

    <!-- ================= 精選五篇 ================= -->
    {featured.length > 0 && (
      <section class="paper sec reads blog-reads">
        <div class="wrap">
          <div class="reads-head">
            <div>
              <div class="label">—— FIVE ESSENTIAL READS · 精選 ——</div>
              <h2>如果你只能讀五篇，我推薦這幾篇</h2>
              <p class="sub">讀者們最常分享、最常回頭再讀的核心長文。從這裡開始，就足夠陪你度過接下來幾個月的迷茫。</p>
            </div>
            <a class="btn btn-ghost" href="#all-posts">看全部文章 →</a>
          </div>
          <div class="read-grid">
            {featured.map((p, i) => (
              <a class={`read ${i === 0 ? 'read-big' : ''}`} href={`/blog/${p.id}`}>
                <div class="read-img">
                  {p.heroImage && <img src={p.heroImage} alt={p.title} loading={i === 0 ? 'eager' : 'lazy'} />}
                  <span class="read-frame">{`REEL ${pad(i + 1)} · DAYDREAM DEX`}</span>
                </div>
                <div class="read-body">
                  <span class="read-tag">{p.tag}</span>
                  <h3>{p.title}</h3>
                  <p>{p.desc}</p>
                  <span class="read-stats">{dotDate(p.pubDate)} · 閱讀 {p.minutes} 分鐘</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= 所有的塵世筆記（分類篩選） ================= -->
    <section id="all-posts" class="dark grain sec archive blog-archive">
      <div class="wrap">
        <div class="archive-head">
          <div>
            <div class="label">—— ARCHIVE ——</div>
            <h2>所有的塵世筆記</h2>
            <p class="sub">{totalPosts} 篇長文，慢慢讀，不必急。</p>
          </div>
          <div class="filters" role="group" aria-label="文章分類">
            <button type="button" class="filter-btn is-active" data-filter="all" aria-pressed="true">全部<span>{totalPosts}</span></button>
            {cats.map((c) => (
              <button type="button" class="filter-btn" data-filter={c} aria-pressed="false">{c}<span>{catCount[c]}</span></button>
            ))}
          </div>
        </div>
        <div class="post-list">
          {posts.map((p) => (
            <a class="post-row" href={`/blog/${p.id}`} data-tag={p.tag}>
              <div class="post-date"><b>{p.date}</b><small>{p.year}</small></div>
              <div class="post-main">
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="post-min">閱讀 {p.minutes} 分鐘</span>
              </div>
              <span class="post-tag">{p.tag}</span>
              <span class="post-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
        <p class="filter-empty" hidden>這個分類還沒有文章。</p>
      </div>
      <script is:inline>
        (function () {
          var btns = document.querySelectorAll('.pv .filter-btn');
          var rows = document.querySelectorAll('.pv .post-row');
          function apply(f) {
            var shown = 0;
            btns.forEach(function (b) {
              var on = b.getAttribute('data-filter') === f;
              b.classList.toggle('is-active', on);
              b.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            rows.forEach(function (r) {
              var show = f === 'all' || r.getAttribute('data-tag') === f;
              r.hidden = !show;
              if (show) shown++;
            });
            var empty = document.querySelector('.pv .filter-empty');
            if (empty) empty.hidden = shown > 0;
          }
          btns.forEach(function (btn) {
            btn.addEventListener('click', function () { apply(btn.getAttribute('data-filter')); });
          });
          // 從文章頁分類標籤進來：/blog#cat-AI
          var hash = '';
          try { hash = decodeURIComponent(location.hash || ''); } catch (e) { hash = ''; }
          if (hash.indexOf('#cat-') === 0) {
            var cat = hash.slice(5);
            var exists = Array.prototype.some.call(btns, function (b) { return b.getAttribute('data-filter') === cat; });
            if (exists) {
              apply(cat);
              var target = document.getElementById('all-posts');
              if (target) target.scrollIntoView();
            }
          }
        })();
      </script>
    </section>

    <V2Footer />
    <NewsletterFloatingCTA />
  </body>
</html>
