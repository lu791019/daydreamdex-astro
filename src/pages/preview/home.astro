    hook: '不只教 AI 技術，更陪你走過學習、轉職到打造個人品牌的每個轉折。',
    title: '企業內訓與學校講座',
    desc: '5 大核心主題：AI 職涯戰略、資料工程、AI 工具、個人品牌、AI Coding。10+ 主持與講座。',
    href: '/instructor',
    go: '看講座主題',
    free: { label: '寫信邀約講座', href: `mailto:${PROFILE.email}?subject=講座／內訓邀約` },
  },
];

// ===== 三幕劇轉型法：電影製作流程 × 導入方法 =====
const acts = [
  {
    no: 'ACT I',
    phase: 'PRE-PRODUCTION',
    title: '前期製作',
    subtitle: '需求探勘與架構規劃',
    items: ['利害關係人訪談與現況盤點（流程、資料、系統）', '痛點排序與 ROI 評估，找出阻力最小的切入點', '技術選型與系統架構藍圖'],
    deliver: ['需求規格書', '系統架構圖', '導入路線圖'],
  },
  {
    no: 'ACT II',
    phase: 'PRODUCTION',
    title: '拍攝製作',
    subtitle: 'MVP 開發與迭代驗證',
    items: ['規格驅動開發（SDD），規格先行、不靠猜', '資料管道、API 串接、LLM／RAG／AI Agent 導入', '短週期 demo，讓使用者邊用邊修'],
    deliver: ['可運作的 MVP', '測試與驗證報告'],
  },
  {
    no: 'ACT III',
    phase: 'POST-PRODUCTION & RELEASE',
    title: '後製與上映',
    subtitle: '部署、交接與自主維運',
    items: ['雲端部署、監控與備份機制', '內容與程式分離，非工程背景也改得動', '技術文件、操作手冊與內部教育訓練'],
    deliver: ['上線系統', '維運文件', '教育訓練'],
  },
];

// ===== 實戰案例 =====
const cases = [
  {
    org: '臺南左鎮智慧街區 × 左達工作室',
    program: '數位發展部「在地數位種子人才培力方案」入選案',
    title: 'LINE 在地問答與資料洞察系統',
    role: 'AI 與資料整合',
    challenge: '計畫有期程，但系統要活得比計畫久；在地夥伴沒有工程背景，工程師撤場後誰來維護？',
    approach: 'LINE 官方帳號問答架構、Webhook 串接、在地知識庫與 KPI 資料層。評估成本與維護性後，這一期刻意不用 LLM，改走關鍵字比對加結構化資料。',
    result: '所有回覆文字放進在地夥伴看得懂、改得動的試算表，工程師離場後仍能自行更新與維運。',
    quote: '一套沒有人維護得了的系統，做得再漂亮都是負債。',
    tags: ['LINE 官方帳號', 'Webhook', '在地知識庫', 'KPI 資料層'],
  },
  {
    org: '合照盟（合作社照顧聯盟）',
    program: '內政部合作社輔導計畫',
    title: 'AI 會議與活動紀錄助手',
    role: 'AI 技術開發',
    challenge: '合作社成員多為兼職，平時沒有紀錄的習慣，考核前才回頭大量補件。',
    approach: '錄音與照片上傳 → Whisper 語音轉文字 → LLM 生成摘要、決議與待辦 → 自動套用主管機關格式 → 匯出 Word／PDF 並雲端歸檔。',
    result: '完整交付原始碼與技術文件；與另一個技術團隊重新劃分工、訂定資料交付規格，不重工。',
    quote: '我用你的引擎，你收我的乾淨資料。',
    tags: ['Whisper', 'LLM 摘要', '自動套版', '跨團隊協作'],
  },
];

// ===== Podcast／影片 =====
const episodes = [ // 第一筆 = 大圖展示
  { title: 'Dex 的多重轉職人生，你討厭的那件事，可能正在讓你變強！', yt: 'LgvTylvlSeE', spotify: 'https://open.spotify.com/episode/423pjnJ4xnIZQb9pmlhB8G' },
  { title: 'EP1：AI 時代下，為什麼副業是轉職最低風險的起點？', yt: 'ZHL29pOabhs', spotify: 'https://open.spotify.com/episode/1Car3CezBikqHXjS4c2fBq' },
  { title: '如何靠副業拿到 80 萬的合約，Dex 的理工職涯策略！', yt: '_gtRaFg4B0w', spotify: 'https://open.spotify.com/episode/5Kg4A5786WlXypTJLqgsvA' },
];

// ===== 影評 =====
const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);

// ===== FOR YOU（原文保留） =====
const forYou: [string, string][] = [
  ['你不孤單', '至少 200 個讀者跟你一樣 30+ 才開始學程式。'],
  ['你不需要學完所有東西', '只需要學「對的那 20%」，我會帶你找到。'],
  ['你不必證明自己', '你願意開始，就已經夠勇敢了。'],
