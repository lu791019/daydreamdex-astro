---
// 職涯諮詢與陪跑（v2 暖光放映廳版）
// 版型（三服務頁共用）：hero → 適合誰 → 怎麼進行 → 方案 → 實績 → 其他服務 → CTA
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import V2ContactCTA from '../components/v2/V2ContactCTA.astro';
import V2ServiceCrossLink from '../components/v2/V2ServiceCrossLink.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import { SITE_TITLE } from '../consts';
import { PROFILE } from '../data/profile';
import '../styles/v2.css';
import '../styles/v2-services.css';

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';

// SEO
const pageTitle = `職涯諮詢與轉職陪跑 ｜ ${SITE_TITLE}`;
const pageDescription = '1on1 諮詢與專題陪跑業師。陪你想清楚轉職、作品集、履歷與技術卡關 — 50 分鐘深度對談。Dex（CDA 國際生涯發展諮詢師 + Life Coach + 50+ 學員 1on1 陪跑經驗）。';

// 找我聊什麼（2 個入口）
const entries = [
  {
    tag: 'A · 個人',
    title: '我想找 1on1 諮詢 / 陪跑',
    desc: '轉職、作品集、履歷、技術卡關 — 50 分鐘深度對談，AAPD 直接預約。',
    cta: '立即預約',
    href: PROFILE.aapdUrl,
  },
  {
    tag: 'B · 機構',
    title: '我們想找專題陪跑業師',
    desc: 'Bootcamp / 大學 / 企業學習單位 — 學員專題 mentor、評鑑、收斂。',
    cta: '寫信聊聊',
    href: `mailto:${PROFILE.email}?subject=專題陪跑業師合作洽詢`,
  },
];

// 適合來找我的人
const audience = [
  { n: '01', t: '想轉職，但不確定路徑', d: '釐清「目標 × 學習路徑 × 職涯策略」' },
  { n: '02', t: '想做作品集，但不知道從哪做起', d: '從「情境 → 技術 → 專題」建立方向' },
  { n: '03', t: '學了技術，卻無法轉成職場能力', d: '整合成企業看得懂的作品集與經驗' },
  { n: '04', t: '履歷投了沒回應', d: '從「作品集 × 履歷 × 求職策略」找斷點' },
  { n: '05', t: '技術學習卡關', d: '從「應用情境 × 整體脈絡」理解技術使用' },
];

// 兩種身分：職涯諮詢師 × 人生教練
const roles = [
  {
    k: 'ROLE 01 · CAREER',
    t: '職涯諮詢師',
    cert: 'CDA 國際生涯發展諮詢師',
    d: '當問題是「下一份工作、下一個方向」：用生涯發展的工具，把興趣、能力、市場需求放在同一張地圖上。',
    items: ['轉職路徑與學習順序', '作品集、履歷與求職策略', '技術卡關時，找回整體脈絡'],
  },
  {
    k: 'ROLE 02 · LIFE',
    t: '人生教練',
    cert: 'Life Coach 生涯教練認證',
    d: '當問題不只是工作，而是「我到底想要什麼」：用教練式提問，陪你在人生轉折處把自己的答案說出來。',
    items: ['人生轉彎時的方向感與節奏', '在選擇與取捨之間，看清自己真正在意的', '從想清楚，到願意跨出第一步'],
  },
];

// 教練風格（pixelarticons）
const styles = [
  { icon: 'bulletlist', t: '結構化引導', d: '把模糊的問題拆成可理解的步驟，不在迷霧裡瞎走。' },
  { icon: 'target', t: '為什麼而學', d: '聚焦目標與應用情境，避免學了技術卻用不上。' },
  { icon: 'link', t: '技術 × 職涯 × 生涯', d: '把能力轉成具體機會，讓技術成為職涯的支點。' },
  { icon: 'human-run', t: '明確下一步行動', d: '不畫大餅，只談這週能怎麼動 — 小步快走勝過完美規劃。' },
];

// 機構合作
const orgFit = ['資料工程 / AI Bootcamp', '大學資工 / 資管 / 統計專題課', '企業內部人才培育（DataOps、AI 導入）', '政府計畫（職訓局、產學合作）', '線上學習平台 / 線上學院'];
const orgRoles = ['專題業師 — 主題訂定、收斂、技術指導', '作品集陪跑 mentor — 1on1 多次回饋', '評審 / 評鑑委員 — Demo Day、結業評分', '主題講座 — 業界視角、職涯方向', '履歷檢診 — 集體場次或 1on1'];
const orgFormats = ['單次講座（2-3 hr）', '系列課程（4-12 週）', '學期 mentor（一屆學員 / 數月）', '專題評審（單場或結業整批）', '客製化方案（依貴單位需求）'];

// 機構合作分群
const orgGroups = [
  { icon: 'teach', tag: 'Bootcamp / 學院', items: PROFILE.trustOrgs.coachingBootcamp },
  { icon: 'building-community', tag: '企業 / 內訓', items: PROFILE.trustOrgs.coachingEnterprise },
  { icon: 'book-open', tag: '大學 / 研究單位', items: PROFILE.trustOrgs.coachingUniversity },
  { icon: 'users', tag: '職涯陪跑 / 履歷', items: PROFILE.trustOrgs.coachingCareer },
];

// 證照（教練頁優先列 CDA + Life Coach，技術 3 張收尾）
const certs = PROFILE.certs;
const students = PROFILE.stats.studentsCoached;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={pageTitle} description={pageDescription} type="website" />
  </head>
  <body class="pv">
    <V2Nav chatHref={FREE_CHAT_URL} hall="HALL 03" />

    <!-- ================= HERO ================= -->
    <header class="dark grain sv-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap sv-hero-grid">
        <div>
          <div class="sv-tag">SCENE 03 <b>職涯諮詢與轉職陪跑</b></div>
          <h1>陪你<em>想清楚</em><br />下一步</h1>
          <p class="sv-hero-sub">職涯諮詢師 <span>×</span> 人生教練 <span>×</span> 轉職陪跑業師</p>
          <div class="scene">
            <div class="scene-label">SCENE · 我的承諾</div>
            <div class="scene-line sv-quote-zh">「{PROFILE.quotes.coach}」</div>
          </div>
          <div class="sv-cred">
            <span>CDA 國際生涯發展諮詢師</span>
            <span>Life Coach 認證</span>
            <span><b>{students}+</b>位學員 1on1 陪跑經驗</span>
          </div>
          <p class="sv-hero-note">現職 AI 技術總監，材料所畢業、非本科轉進資料與 AI。轉職卡關可以找我，人生卡關也可以 —— 我同時是職涯諮詢師和人生教練。</p>
          <div class="ctas">
            <a class="btn btn-amber" href={PROFILE.aapdUrl} target="_blank" rel="noopener noreferrer">立即預約諮詢 →</a>
            <a class="btn btn-line" href={FREE_CHAT_URL} target="_blank" rel="noopener noreferrer">先免費聊 15 分鐘</a>
          </div>
        </div>

        <aside class="sv-slate" aria-label="1on1 諮詢資訊">
          <div class="sv-slate-top" aria-hidden="true"></div>
          <div class="sv-slate-k"><span>CALL SHEET</span><span>TAKE 1on1</span></div>
          <span class="sv-slate-stamp" aria-hidden="true">開放<br />預約中</span>
          <h2>1on1 諮詢</h2>
          <dl>
            <div><dt>費用</dt><dd>{PROFILE.consultingFee}</dd></div>
            <div><dt>時段</dt><dd>{PROFILE.consultingHours}<small>台灣 / 香港 / 新加坡 / 馬來西亞</small></dd></div>
            <div><dt>聊什麼</dt><dd>轉職、作品集、履歷、技術卡關、人生轉折</dd></div>
          </dl>
          <div class="sv-slate-foot">
            <a class="btn btn-cta" href={PROFILE.aapdUrl} target="_blank" rel="noopener noreferrer">AAPD 預約 →</a>
          </div>
        </aside>
      </div>
    </header>

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= REEL 01 適合誰 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 01 · 適合誰</div>
          <h2>找我聊什麼？</h2>
        </div>
        <div class="sv-grid sv-grid-2">
          {entries.map((e) => (
            <a class="sv-card" href={e.href} target={e.href.startsWith('mailto') ? undefined : '_blank'} rel="noopener noreferrer">
              <span class="sv-no">{e.tag}</span>
              <h3>{e.title}</h3>
              <p>{e.desc}</p>
              <span class="sv-go">{e.cta} →</span>
            </a>
          ))}
        </div>

        <h3 class="sv-sub-h">適合來找我的人</h3>
        <p class="sv-sub-p">如果你在這些卡關時刻，正是我能幫上忙的地方。</p>
        <div class="sv-rows">
          {audience.map((a) => (
            <div class="sv-row">
              <span class="sv-row-n">{a.n}</span>
              <div><h3>{a.t}</h3><p>{a.d}</p></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= REEL 02 怎麼進行 ================= -->
    <section class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 02 · 怎麼進行</div>
          <h2>兩種陪伴：職涯諮詢師 × 人生教練</h2>
          <p class="sub">有時候卡住的是工作，有時候卡住的是人生。50 分鐘裡，我會先聽你說，再判斷今天要戴哪一頂帽子 —— 或兩頂一起。</p>
        </div>
        <div class="sv-roles">
          {roles.map((r) => (
            <div class="sv-role">
              <div class="sv-role-k">{r.k}</div>
              <h3>{r.t}</h3>
              <p class="sv-role-cert">{r.cert}</p>
              <p>{r.d}</p>
              <ul class="sv-list">{r.items.map((x) => <li>{x}</li>)}</ul>
            </div>
          ))}
        </div>

        <h3 class="sv-sub-h">Dex 的教練風格</h3>
        <div class="sv-grid sv-grid-4">
          {styles.map((s) => (
            <div class="sv-card sv-card-d">
              <span class="sv-icon" aria-hidden="true"><Icon name={`pixelarticons:${s.icon}`} width={26} height={26} /></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= REEL 03 方案 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 03 · 方案</div>
          <h2>1on1 諮詢方案</h2>
        </div>
        <div class="sv-plan">
          <div class="sv-plan-main">
            <div class="sv-plan-k">NOW SHOWING · A · 個人諮詢</div>
            <h3>1on1 深度對談</h3>
            <div class="sv-plan-price">{PROFILE.consultingFee}</div>
            <p>{PROFILE.consultingHours}（台灣 / 香港 / 新加坡 / 馬來西亞）</p>
            <p>預約後可先寫信給我，附上你想聊的主題與背景脈絡，我會在諮詢前先看過。</p>
          </div>
          <div class="sv-plan-stub">
            <a class="btn btn-amber" href={PROFILE.aapdUrl} target="_blank" rel="noopener noreferrer">立即預約諮詢（AAPD）→</a>
            <small>透過 AAPD 平台預約，由擺渡職涯統一收費與排程，安心對接。</small>
            <a class="btn btn-line btn-sm" href={FREE_CHAT_URL} target="_blank" rel="noopener noreferrer">還不確定？先免費聊 15 分鐘</a>
          </div>
        </div>

        <div class="sv-head" style="margin-top:88px;">
          <div class="sv-reel">B · 機構合作</div>
          <h2>專題陪跑業師 / 學員 Mentor</h2>
          <p class="sub">過去 5+ 年，固定為 Bootcamp、大學課程與企業學習單位擔任專題業師、Mentor、評審。不是「教完一門課就走」，而是陪學員把專題真的做到能放上履歷、講得出來、面試官聽得懂。</p>
        </div>
        <div class="sv-grid sv-grid-2">
          <div class="sv-card">
            <span class="sv-no">WHO</span>
            <h3>適合的合作對象</h3>
            <ul class="sv-list">{orgFit.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="sv-card">
            <span class="sv-no">ROLE</span>
            <h3>可以提供的角色</h3>
            <ul class="sv-list">{orgRoles.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
        <div class="sv-tip">
          <div>
            <div style="margin-bottom:12px;">常見合作方式</div>
            <div class="sv-chips">{orgFormats.map((x) => <span>{x}</span>)}</div>
          </div>
          <a class="btn btn-cta" href={`mailto:${PROFILE.email}?subject=專題陪跑業師合作洽詢`}>寫信聊聊 →</a>
        </div>
      </div>
    </section>

    <!-- ================= REEL 04 實績 ================= -->
    <section class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 04 · 實績</div>
          <h2>過往機構合作經歷</h2>
          <p class="sub">累積 {students}+ 位學員 1on1 陪跑 — 不只在「教方法」，更在「陪一個人慢慢長出方向」。</p>
        </div>
        <div class="sv-grid sv-grid-2">
          {orgGroups.map((g) => (
            <div class="sv-card sv-card-d sv-group">
              <h3><Icon name={`pixelarticons:${g.icon}`} width={22} height={22} />{g.tag}</h3>
              <ul class="sv-list">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>

        <div class="sv-certs" aria-label="專業背景">
          <span>專業背景 · CERTIFIED</span>
          {certs.map((c) => <b>{c.label}</b>)}
        </div>

        <div class="final-scene sv-belief">
          <span class="final-tag">FINAL SCENE</span>
          <div class="scene-line">“{PROFILE.quotes.coachBelief}”</div>
          <div class="scene-sub">—— 也是我陪每一位學員的核心信念</div>
        </div>
      </div>
    </section>

    <V2ServiceCrossLink current="coaching" />
    <V2ContactCTA variant="coaching" chatHref={FREE_CHAT_URL} />
    <V2Footer />
    <NewsletterFloatingCTA />
  </body>
</html>
