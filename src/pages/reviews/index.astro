---
// 影評放映室
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import SEO from '../../components/SEO.astro';
import V2Nav from '../../components/v2/V2Nav.astro';
import V2Footer from '../../components/v2/V2Footer.astro';
import { SHORT_REVIEWS } from '../../data/short-reviews';
import '../../styles/v2.css';

const CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';
const PODCAST_FILM_URL = 'https://open.spotify.com/show/5oy6A25HTtZE9hQAMSJCML';
const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title="影評放映室｜Dex 的塵世哲學" description="工程師也是影評人。Dex 的長篇影評與影展不爆雷短評：阿莫多瓦《人聲》、徐浩峰《師父》、銀河映像《樹大招風》，以及影展片單短評。" type="website" />
  </head>
  <body class="pv">
    <V2Nav homeHref="/" chatHref={CHAT_URL} />

    <header class="dark grain cinema reviews-hero">
      <div class="cinema-strip" aria-hidden="true"></div>
      <div class="wrap">
        <div class="now-showing">● NOW SHOWING · SCREENING ROOM</div>
        <h1 class="page-h1">影評放映室</h1>
        <p class="sub">我也是個影評人。轉職、選方向、找特質 —— 一部電影能說清楚的事，程式碼說不出來。</p>
        <a class="film-pod" href={PODCAST_FILM_URL} target="_blank" rel="noopener noreferrer">
          <span class="film-pod-icon" aria-hidden="true">🎙</span>
          <span><b>聽《塵影》</b><small>說書 × 電影的 Podcast · 第一集：當代名導的電影大師課</small></span>
          <span class="film-pod-go">收聽 →</span>
        </a>

        <div class="label review-label">LONG REVIEWS · 長篇影評</div>
        <div class="review-grid">
          {reviews.map((r, i) => (
            <a class="review" href={`/reviews/${r.id}`}>
              <div class="review-top"><span>{`ADMIT ONE · No. ${String(i + 1).padStart(3, '0')}`}</span><span>★ 影評</span></div>
              <h3>{r.data.title}<small>{r.data.en}</small></h3>
              <div class="review-dir">導演｜{r.data.director}</div>
              <blockquote>「{r.data.pull}」</blockquote>
              <p class="review-lead">{r.data.description}</p>
              <span class="review-more">讀完整影評 →</span>
            </a>
          ))}
        </div>

        <div class="shorts-head" id="festival-notes">
          <div class="label">FESTIVAL NOTES · 影展短評</div>
          <p class="shorts-intro">第一次不爆雷短評，請小力鞭 😂</p>
        </div>
        <div class="shorts-grid">
          {SHORT_REVIEWS.map((r, i) => (
            <article class="short">
              <span class="short-no">{`FRAME ${String(i + 1).padStart(2, '0')}`}</span>
              <h3>{r.film}</h3>
              <p>{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </header>

    <V2Footer />
  </body>
</html>
