---
// 首頁（2026-10 服務站改版上線；舊版見 git tag backup/pre-service-hub-2026-09-27）
// 視覺：A「暖光放映廳」為主 + B 底片框；字型一律黑體（英文台詞用 Georgia 斜體）
// 文案：原首頁文字為主體，新內容補強；經歷以《Dex綜合履歷_領袖100》為準
// 2026-10-01 critique 修正：hero 精簡、三幕劇／案例移到 /consultant（首頁留預告）、
// 影展短評移到 /reviews、文章列表只留最新 5 篇、預約區補費用／對象／流程
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import { getSubscriberCount } from '../utils/kit';
import { inferTag, readingMinutes } from '../utils/post-meta';
import { FEATURED_POST_SLUGS, CTA_BOOKING_URL, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { PROFILE } from '../data/profile';
import '../styles/v2.css';

const subscriberCount = await getSubscriberCount();

// 免費先聊（個人）：Calendly 15 分鐘。機構尚無專用 event type，先改寫信對焦需求
const FREE_CHAT_PERSONAL_URL = 'https://calendly.com/daydreamisexp/meet-with-me';
const ORG_INQUIRY_HREF = `mailto:${PROFILE.email}?subject=${encodeURIComponent('機構合作需求對焦')}`;
const ORG_INQUIRY_LABEL = '寫信預約需求對焦（30 分鐘）';
const PODCAST_MAIN_URL = 'https://open.spotify.com/show/2qV49EUjFOcJIqkUjwmu2T';
const PODCAST_FILM_URL = 'https://open.spotify.com/show/5oy6A25HTtZE9hQAMSJCML';

// 諮詢：時長統一 50 分鐘；費用取自 PROFILE.consultingFee 的金額部分
const CONSULT_MINUTES = 50;
const CONSULT_PRICE = PROFILE.consultingFee.split('/')[0].trim();
const LEAD_MAGNET = 'AI 工程師與資料工程師的轉職指南'; // 與 NewsletterFloatingCTA、Kit 登陸頁一致
const LATEST_COUNT = 5;

// ===== 文章 =====
const allPosts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const slugOf = (id: string) => id.replace(/\.mdx?$/, '');

const posts = allPosts.map((p) => {
  const d = p.data.pubDate;
  return {
    slug: slugOf(p.id),
    title: p.data.title,
    desc: p.data.description,
    heroImage: p.data.heroImage as string | undefined,
    tag: inferTag(p.data.title, p.data.description),
    minutes: readingMinutes(p.body ?? ''),
    date: `${String(d.getMonth() + 1).padStart(2, '0')} / ${String(d.getDate()).padStart(2, '0')}`,
    year: String(d.getFullYear()),
  };
});
const totalPosts = posts.length;
const latest = posts[0];
const latestPosts = posts.slice(0, LATEST_COUNT);

const featured = FEATURED_POST_SLUGS.map((slug) => posts.find((p) => p.slug.includes(slug)))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const forYouPost = featured[0];
// 熱門文章：首頁其他區塊沒連到的文章也放一份內部連結（2026-10 SEO：避免排名頁失去首頁連結）
const linkedSlugs = new Set([...latestPosts, ...featured].map((p) => p.slug));
const morePosts = posts.filter((p) => !linkedSlugs.has(p.slug));

// ===== 經歷（綜合履歷） =====
const reel = [
  { year: '2016', org: '台灣美光', role: 'DRAM 缺陷分析' },
  { year: '2019', org: 'TutorABC', role: '大數據工程師' },
  { year: '2021', org: 'LINE Bank', role: '資料工程師' },
  { year: '2021', org: '緯創資通', role: '後端 × 資料工程' },
  { year: '2025', org: '水球軟體學院', role: 'AI 課程行銷' },
  { year: '2026', org: '哈馬星科技', role: 'AI 技術總監' },
];

// ===== 獎座櫃：指標性實績（依《Dex綜合履歷_領袖100》）；icon 用 pixelarticons =====
const trophies = [
  { icon: 'users', name: '50+ 位轉職學員', note: '一對一陪跑：作品集、履歷、面試' },
  { icon: 'teach', name: 'TibaMe 轉職班業師', note: '資料工程九大模組 63 小時帶狀課' },
  { icon: 'mic', name: '每年回校園開講', note: '立志中學・樹德科大職涯講座' },
  { icon: 'terminal', name: 'PyCon TW 2024', note: '一般議程主持人・議程組成員' },
  { icon: 'map-pin', name: '數位部入選案', note: '在地數位種子人才・臺南左鎮' },
  { icon: 'message-text', name: 'AI 會議紀錄助手', note: '合照盟・內政部合作社輔導計畫' },
  { icon: 'heart', name: '全齡生涯發展協會', note: '社團法人台灣全齡生涯發展協會・理事' },
  { icon: 'radio-tower', name: '單篇 7.9 萬觸及', note: 'Threads 近 4,000 追蹤' },
];
const CERTS = ['CDA 國際生涯發展諮詢師', 'Life Coach 生涯教練', 'Microsoft 大數據與資料科學', 'AWS AI Practitioner', 'Google GenAI'];

// ===== 三種找我的方式（原名稱保留） =====
const doors = [
  {
    who: '個人 · 諮詢陪跑',
    hook: '你缺的，可能不是技術，是一個陪你把問題想清楚的人。',
    title: '職涯諮詢與陪跑',
    desc: `1on1 ${CONSULT_MINUTES} 分鐘深度對談 · 轉職、作品集、履歷、技術卡關。CDA + Life Coach + 50+ 學員陪跑經驗。`,
    href: '/coaching',
    go: '看諮詢方案',
    free: { label: '先免費聊 15 分鐘', href: FREE_CHAT_PERSONAL_URL },
  },
  {
    who: '企業 · 顧問內訓',
    hook: '數位轉型不是買一套系統，是讓系統在工程師離場後還活著。',
    title: 'AI 與資料自動化導入',
    desc: '數位轉型 × AI 轉型的規劃、建置與顧問：資料自動化、LLM 與 AI Agent 導入、技術／資料／數位行銷顧問。10 年技術職涯，做得起的解法。',
    href: '/consultant',
    go: '看顧問服務',
    free: { label: ORG_INQUIRY_LABEL, href: ORG_INQUIRY_HREF },
  },
  {
    who: '機構 · 講座邀約',
    hook: '不只教 AI 技術，更陪你走過學習、轉職到打造個人品牌的每個轉折。',
    title: '企業內訓與學校講座',
    desc: '5 大核心主題：AI 職涯戰略、資料工程、AI 工具、個人品牌、AI Coding。10+ 主持與講座。',
    href: '/instructor',
    go: '看講座主題',
    free: { label: '寫信邀約講座', href: `mailto:${PROFILE.email}?subject=${encodeURIComponent('講座／內訓邀約')}` },
  },
];

// ===== 方法與案例預告（完整內容在 /consultant） =====
const caseTeasers = [
  { no: 'CASE 01', org: '臺南左鎮 × 數位部入選案', title: 'LINE 在地問答與資料洞察系統' },
  { no: 'CASE 02', org: '合照盟 × 內政部合作社輔導計畫', title: 'AI 會議與活動紀錄助手' },
];

// ===== Podcast／影片 =====
const episodes = [ // 第一筆 = 大圖展示（最新一集）
  { title: 'Dex 的多重轉職人生，你討厭的那件事，可能正在讓你變強！', yt: 'LgvTylvlSeE', spotify: 'https://open.spotify.com/episode/423pjnJ4xnIZQb9pmlhB8G' },
  { title: 'EP1：AI 時代下，為什麼副業是轉職最低風險的起點？', yt: 'ZHL29pOabhs', spotify: 'https://open.spotify.com/episode/1Car3CezBikqHXjS4c2fBq' },
  { title: '如何靠副業拿到 80 萬的合約，Dex 的理工職涯策略！', yt: '_gtRaFg4B0w', spotify: 'https://open.spotify.com/episode/5Kg4A5786WlXypTJLqgsvA' },
];

// ===== 影評 =====
const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);

// ===== FOR YOU（原文保留，移到預約區旁） =====
const forYou: [string, string][] = [
  ['你不孤單', '我陪過的 50+ 位學員裡，很多人跟你一樣 30+ 才開始學程式。'],
  ['你不需要學完所有東西', '只需要學「對的那 20%」，我會帶你找到。'],
  ['你不必證明自己', '你願意開始，就已經夠勇敢了。'],
  ['你不會被 AI 取代', '只要你願意學會，如何跟 AI 一起工作。'],
];
const PROMISES = ['不寫速成懶人包，每篇都來自真實走過的路', '不販賣轉職焦慮，只談長期可持續的路徑', '每一封來信，都由我親自讀、親自回'];
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={SITE_TITLE} description={SITE_DESCRIPTION} type="website" />
  </head>
  <body class="pv">
    <V2Nav homeHref="/" chatHref={FREE_CHAT_PERSONAL_URL} />

    <!-- ================= HERO ================= -->
    <header class="hero grain dark">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <svg class="cam-watermark" width="640" height="640" viewBox="0 0 32 32" aria-hidden="true">
        <g fill="none" stroke="#F3EBDD" stroke-width="0.35" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="9" cy="6" r="3.2" /><circle cx="9" cy="6" r="0.9" />
          <circle cx="17" cy="6" r="3.2" /><circle cx="17" cy="6" r="0.9" />
          <path d="M9 9.2v2M17 9.2v2" /><rect x="3" y="11" width="18" height="11" rx="1.4" />
          <circle cx="12" cy="16.5" r="3" /><circle cx="12" cy="16.5" r="1.2" /><path d="M21 14l5-2v8l-5-2z" />
        </g>
      </svg>

      <div class="wrap hero-grid">
        <div class="hero-copy">
          <div class="clapper" aria-hidden="true">
            <svg width="190" height="140" viewBox="0 0 200 150" aria-hidden="true">
              <rect x="6" y="0" width="188" height="36" rx="3" fill="#F3EBDD" />
              {Array.from({ length: 8 }).map((_, i) => (
                <polygon points={`${10 + i * 24},2 ${28 + i * 24},2 ${22 + i * 24},34 ${4 + i * 24},34`} fill="#16100C" />
              ))}
              <rect x="6" y="42" width="188" height="100" rx="3" fill="#F3EBDD" />
              <g fill="#16100C" font-family="'Noto Sans TC','PingFang TC',sans-serif">
                <text x="20" y="64" font-size="9" opacity="0.55" letter-spacing="1">PROD.</text>
                <text x="20" y="82" font-size="15" font-weight="800">Dex 的塵世哲學</text>
                <line x1="20" y1="90" x2="180" y2="90" stroke="#16100C" stroke-width="0.5" opacity="0.3" />
                <text x="20" y="105" font-size="8" opacity="0.55" letter-spacing="1">SCENE</text>
                <text x="58" y="106" font-size="11">{String(totalPosts).padStart(2, '0')}</text>
                <text x="100" y="105" font-size="8" opacity="0.55" letter-spacing="1">TAKE</text>
                <text x="135" y="106" font-size="11">10</text>
                <line x1="20" y1="113" x2="180" y2="113" stroke="#16100C" stroke-width="0.5" opacity="0.3" />
                <text x="20" y="128" font-size="8" opacity="0.55" letter-spacing="1">DIRECTOR</text>
                <text x="70" y="129" font-size="10" font-style="italic">Dex</text>
                <text x="100" y="128" font-size="8" opacity="0.55" letter-spacing="1">ROLL</text>
                <text x="135" y="129" font-size="10" font-style="italic">2026</text>
              </g>
            </svg>
            <span class="stamp">ACTION!</span>
          </div>

          <div class="pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l-5 7h10z" /><ellipse cx="12" cy="16" rx="6" ry="4" opacity="0.5" stroke-dasharray="2 2" /><path d="M12 10v3" /></svg>
            工程師 × 影評人 · {totalPosts} 篇給工程師的長信
          </div>

          <h1>慢慢走，<br />把每一次<em>轉彎</em>，<br />都走成一條長路。</h1>
          <p class="h1-sub">不管是<b>職涯轉換</b>，還是<b>數位轉型</b>。</p>

          <p class="lead">
            這裡是 Dex 的塵世筆記 —— 寫給每個正在軟體工程、資料工程、AI 路上的你。
            我也陪企業把數據與 AI 轉型真正落地，陪人在人生的轉折處，想清楚下一步。<br />
            <span class="dim">偶爾，我們也聊聊電影裡的人生。</span>
          </p>

          <div class="ctas">
            <a class="btn btn-amber" href="#reads">從一篇文章開始 →</a>
            <a class="btn btn-line" href="#book">預約一場諮詢</a>
            <span class="aside">· {CONSULT_MINUTES} 分鐘，不催促</span>
          </div>

          <nav class="hero-paths" aria-label="其他入口">
            <a href={FREE_CHAT_PERSONAL_URL} target="_blank" rel="noopener noreferrer">還不確定？先免費聊 15 分鐘 →</a>
            <a href="#doors">企業／機構合作 →</a>
            <a href="/coaching">人生卡關了？人生教練 →</a>
          </nav>
        </div>

        <div class="hero-visual">
          <div class="film-frame">
            <picture>
              <source type="image/avif" srcset="/photos/dex-portrait-1-640.avif" />
              <img src="/photos/dex-portrait-1-640.webp" alt="Dex 盧冠宏" width="340" height="340" loading="eager" fetchpriority="high" />
            </picture>
          </div>
          <div class="card card-readers">
            <div class="dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <div>
              <b>{subscriberCount ? `${subscriberCount}+ 位讀者` : '慢慢累積中的讀者'}</b>
              <small>{subscriberCount ? '一起在這條路上' : '邀你一起在路上'}</small>
            </div>
          </div>
          {latest && (
            <a class="card card-latest" href={`/blog/${latest.slug}`}>
              <small><i class="rec" aria-hidden="true"></i>NOW SHOWING · 最新文章</small>
              <b>{latest.title}</b>
            </a>
          )}
          <div class="card card-chair">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F3EBDD" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" /><path d="M3 9h18" /><path d="M5.5 9v3l-1 9M18.5 9v3l1 9" /><path d="M5 12h14l-1 3H6z" /></svg>
            <div><b>諮詢開放預約中</b><small>不勉強，有需要再來</small></div>
          </div>
        </div>
      </div>
    </header>

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= LETTER（原文） ================= -->
    <section class="paper letter" data-newsletter-trigger>
      <div class="wrap narrow">
        <div class="quote-mark" aria-hidden="true">“</div>
        <div class="label">—— A LETTER TO YOU ——</div>
        <h2 class="letter-h">當所有人都在喊<span class="warm">「快」</span>的時候，<br />你需要的，可能是<span class="underline">一段慢慢走的路</span>。</h2>
        <div class="letter-body">
          我懂你的猶豫。30 多歲還能轉職嗎、沒有資工背景行不行、AI 取代了我怎麼辦……<br />
          這些問題，我自己也問過自己很多次。<br /><br />
          所以這個部落格，不是給你<span class="mark">「七天速成資料工程師」</span>那種速食。<br />
          我寫的是 ——<b>那些工程師職涯裡，真正會陪你走十年的東西</b>。
        </div>
        <div class="scene scene-paper">
          <div class="scene-label">SCENE 02 · 信念</div>
          <div class="scene-line">“It's not who you are underneath, it's what you do that defines you.”</div>
          <div class="scene-sub">—— 履歷不是你寫了什麼，是你做過什麼。</div>
        </div>
        <div class="sign"><i></i>Dex，寫於 2026 春天的台北戲院散場後</div>

        <div class="values">
          {[
            ['長期主義的職涯思考', '不追熱門技術，我們聊的是「十年後你會在哪裡」這種問題。'],
            ['可實踐的學習路徑', '從零到第一份工作，每一步都有人走過 —— 你不是一個人。'],
            ['電影裡的職涯隱喻', '我也是個影評人。一部電影裡，常常藏著一段你正在走的路。'],
          ].map(([t, d], i) => (
            <div class="value">
              <span class="value-no">{`TAKE 0${i + 1}`}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= FIVE ESSENTIAL READS（原版面） ================= -->
    <section id="reads" class="paper sec reads">
      <div class="wrap">
        <div class="reads-head">
          <div>
            <div class="label">—— FIVE ESSENTIAL READS ——</div>
            <h2>如果你只能讀五篇，我推薦這幾篇</h2>
            <p class="sub">讀者們最常分享、最常回頭再讀的核心長文。從這裡開始，就足夠陪你度過接下來幾個月的迷茫。</p>
          </div>
          <a class="btn btn-ghost" href="/blog">看全部 {totalPosts} 篇 →</a>
        </div>
        <div class="read-grid">
          {featured.map((p, i) => (
            <a class={`read ${i === 0 ? 'read-big' : ''}`} href={`/blog/${p.slug}`}>
              <div class="read-img">
                {p.heroImage && <img src={p.heroImage} alt="" loading={i === 0 ? 'eager' : 'lazy'} />}
                <span class="read-frame" aria-hidden="true">DAYDREAM · DEX</span>
              </div>
              <div class="read-body">
                <span class="read-tag">{p.tag}</span>
                <h3>{p.title}</h3>
                <p>{p.desc}</p>
                <span class="read-stats">閱讀約 {p.minutes} 分鐘</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= 三種找我的方式 ================= -->
    <section id="doors" class="dark grain doors">
      <div class="wrap">
        <div class="label center">—— SERVICES ——</div>
        <h2 class="center">三種找我的方式</h2>
        <p class="sub center">個人想清楚下一步 · 企業需要技術導入 · 機構邀約講座</p>
        <div class="door-grid">
          {doors.map((d, i) => (
            <div class="door">
              <div class="door-no">{`DOOR 0${i + 1}`}</div>
              <div class="door-who">{d.who}</div>
              <h3>{d.title}</h3>
              <p class="door-hook">{d.hook}</p>
              <p class="door-desc">{d.desc}</p>
              <div class="door-actions">
                <a class="btn btn-amber btn-sm" href={d.href}>{d.go} →</a>
                {d.free.href.startsWith('http') ? (
                  <a class="door-free" href={d.free.href} target="_blank" rel="noopener noreferrer">{d.free.label}</a>
                ) : (
                  <a class="door-free" href={d.free.href}>{d.free.label}</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= PART ONE ================= -->
    <section class="paper sec">
      <div class="wrap">
        <div class="label">PART ONE · 起點</div>
        <h2>一個從半導體跨到 AI 的長期主義者。</h2>
        <p class="sub">材料所畢業，十年跨過四個產業 —— 從晶圓上的瑕疵、銀行的資料管道，到帶一支 AI 團隊。</p>
        <div class="story-grid">
          <div class="bigquote">科系決定不了<br />你的命運，<br />能不能一直重新學，<br />才決定。<small>—— 每年回到高中、科大講職涯時，我最想說的一句</small></div>
          <div class="story">
            <p>我是 Dex，現在是 <b>AI 技術總監</b>，也是職涯教練與人生教練。材料所畢業，<b>不是資訊本科</b>。</p>
            <p>2016 年我在美光做 DRAM 缺陷分析，每天看的是晶圓上的瑕疵。後來自學跨進大數據：TutorABC 的資料湖與預測模型、LINE Bank 的資料管道、緯創全球工廠的 ESG 數據平台。</p>
            <p>技術做順了，我卻做了一個很多人不理解的決定：<b>去程式教育機構做行銷</b>。技術圈的解讀是「走偏了」。但我想搞懂一個產品從「被做出來」到「被需要」之間，到底發生了什麼 —— 那段路後來變成我最重要的能力：把技術講成別人聽得懂、也願意行動的話。</p>
            <p>跨界十年，做過四種專業，踩過你正在踩的那些坑。這幾年陪 50+ 位學員走過轉職這條路。如果你正在迷茫，<span class="mark">我想告訴你，慢慢來，真的會走到的</span>。</p>
            <div class="scene scene-paper">
              <div class="scene-label">SCENE 01 · 起點</div>
              <div class="scene-line">“Now you can know everything in the world, but the only way you're finding out that one is by giving it a shot.”</div>
              <div class="scene-sub">—— 你可以讀遍世界所有的書，但要知道某一件事到底是怎麼回事，唯一的方法，是去試試看。《心靈捕手》</div>
            </div>
            <div class="story-ctas">
              <a class="btn btn-cta" href="/about">認識完整的我 →</a>
              <a class="btn btn-ghost" href={`mailto:${PROFILE.email}`}>寫信給我</a>
            </div>
          </div>
        </div>

        <div class="reel" aria-label="經歷膠捲">
          {reel.map((r) => (
            <div class="reel-frame">
              <span class="reel-year">{r.year}</span>
              <b>{r.org}</b>
              <small>{r.role}</small>
            </div>
          ))}
        </div>

        <div class="trophy" aria-label="證照與實績">
          <div class="trophy-head">
            <div><div class="trophy-k">TROPHY CABINET · 代表作</div><h3>獎座櫃</h3></div>
            <span class="trophy-count">{trophies.length} 座入櫃</span>
          </div>
          <div class="trophy-case">
            {[trophies.slice(0, 4), trophies.slice(4)].map((row) => (
              <div class="trophy-shelf">
                {row.map((t) => (
                  <div class="trophy-item">
                    <span class="medal" aria-hidden="true"><Icon name={`pixelarticons:${t.icon}`} width={34} height={34} aria-hidden="true" /></span>
                    <b>{t.name}</b>
                    <small>{t.note}</small>
                  </div>
                ))}
              </div>
            ))}
          </div>
          <p class="trophy-certs"><span>CERTIFIED</span>{CERTS.join('・')}</p>
        </div>

        <div class="stats">
          <div><b>10</b><span>年跨界</span></div>
          <div><b>4</b><span>個產業 · 6 家公司</span></div>
          <div><b>50+</b><span>轉職學員陪跑</span></div>
          <div><b>10+</b><span>場主持與講座</span></div>
        </div>
      </div>
    </section>

    <!-- ================= ON AIR ================= -->
    <section class="dark grain onair">
      <div class="wrap">
        <div class="onair-head">
          <div>
            <div class="label"><span class="rec" aria-hidden="true"></span>ON AIR · 聲音與影像</div>
