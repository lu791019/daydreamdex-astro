---
// 企業內訓與學校講座（v2 暖光放映廳版）
// 版型（三服務頁共用）：hero → 適合誰 → 怎麼進行 → 方案 → 實績 → 其他服務 → CTA
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import V2ContactCTA from '../components/v2/V2ContactCTA.astro';
import V2ServiceCrossLink from '../components/v2/V2ServiceCrossLink.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import { SITE_TITLE } from '../consts';
import { PROFILE } from '../data/profile';
import '../styles/v2.css';
import '../styles/v2-services.css';

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';
const MAIL_URL = `mailto:${PROFILE.email}?subject=講座邀約洽詢`;

const pageTitle = `企業與大專院校講座、內訓 ｜ ${SITE_TITLE}`;
const pageDescription = '邀請 Dex 講座 / 內訓 / 課程。10+ 主持與講座、50+ 轉職學員指導。AI 時代職涯戰略、資料工程、AI 工具應用、個人品牌、AI Coding 技術導入 — 5 大核心主題可邀約。';

// 主辦單位類型（pixelarticons）
const hosts = [
  { icon: 'book-open', t: '學校', sub: '大學 / 高中', d: '產學講座、職涯講座、技術分享' },
  { icon: 'device-laptop', t: 'Bootcamp', sub: '學院 / 學習平台', d: '主題講座、PBL 業師、作品集陪跑' },
  { icon: 'building-community', t: '企業', sub: '企業內訓', d: 'DataOps / AI 導入 / 開發者分享' },
  { icon: 'users', t: '公部門 / 社群', sub: '政府 / 社群活動', d: '產學合作、社群高峰會、議程主持' },
];

// 數據成果
const stats = [
  { n: '10+', t: '主持與講座', d: '含產學 / 大型線上 / 社群' },
  { n: '50+', t: '轉職學員指導', d: 'TibaMe / AC / 六角 / 學米等' },
  { n: '3', t: '專業身分', d: '程式業師 / 職涯教練 / 內容創作者' },
  { n: '5', t: '專業證照', d: 'MPP / AWS / Google / CDA / Life Coach' },
];

// 為什麼選 Dex
const whyDex = [
  { icon: 'heart', t: '同理心教學', d: '10 年技術職涯 + 50+ 學員陪跑 — 知道學生卡在哪，從學生視角拆問題。' },
  { icon: 'briefcase', t: '業界真實深度', d: `${PROFILE.careerOrgs.join(' / ')} — 真的在做，不是只在教。案例都是現場。` },
  { icon: 'code', t: 'PBL 實戰教學', d: '融入專題式學習與業界案例，不是純講概念 — 學員下課就能動。' },
  { icon: 'target', t: '職涯整合視角', d: 'CDA 國際諮詢師 + Life Coach — 技術不只是技術，能接到職涯與生涯。' },
];

// 通用講座：同一主標，兩個版本
const SIGNATURE_TITLE = '職涯經驗與 AI 發展應用：一個非本科 AI 工程師的路，和未來即將進入的世界';
const signatureTalks = [
  {
    ver: 'A 版 · AI 實戰版',
    axis: '主軸：看懂 AI 正在改變的世界，現場看 AI 怎麼真的幫你做事',
    meta: ['2 小時', '兩段現場示範', '可依對象調整深度'],
    rundown: [
      { time: '0:00–0:20', t: '開場：一個非本科生的路', d: '材料所畢業，從半導體、大數據、銀行資料工程，走到 AI 技術總監。', demo: false },
      { time: '0:20–0:45', t: '未來即將進入的世界', d: '生成式 AI 與 AI Agent 正在改變哪些工作、又打開哪些新機會。', demo: false },
      { time: '0:45–1:10', t: '現場示範 ①：用 AI 做「大學科系觀測站」', d: '把科系資訊、課程與出路整理成一個可以查、可以比較的觀測站。', demo: true },
      { time: '1:10–1:35', t: '現場示範 ②：AI 派工', d: '一個人怎麼把任務拆開，交給一組 AI 助手分工完成，再自己驗收。', demo: true },
      { time: '1:35–2:00', t: '帶走的下一步 + Q&A', d: '會用 AI 不是終點，懂得問對問題、驗收結果，才是能力。', demo: false },
    ],
    fit: '高中、大專院校、青年職涯活動、企業新人與跨領域轉職者',
  },
  {
    ver: 'B 版 · 職涯規劃版',
    axis: '主軸：地圖 → 羅盤 → 路線與行李 → 90 天第一步',
    meta: ['2 小時', 'AI 拆解職缺示範', '含個人行動單'],
    rundown: [
      { time: '0:00–0:15', t: '開場：一個非本科生的路', d: '科系決定不了你的命運，能不能一直重新學，才決定。', demo: false },
      { time: '0:15–0:40', t: '地圖：未來即將進入的世界', d: 'AI 時代的產業與職務變化 —— 先看清楚地形，再決定往哪走。', demo: false },
      { time: '0:40–1:00', t: '羅盤：認識自己', d: '興趣、能力、價值觀 —— 用生涯諮詢的工具，找到自己的方向。', demo: false },
      { time: '1:00–1:35', t: '路線與行李 + 現場示範：用 AI 拆解職缺', d: '把一則真實職缺拆成技能、經驗與作品，看出「還缺什麼行李」。', demo: true },
      { time: '1:35–2:00', t: '90 天第一步 + Q&A', d: '把今天的地圖與羅盤，寫成接下來 90 天做得到的第一步。', demo: false },
    ],
    fit: '高中升學與選系、大學生職涯探索、待業與轉職族群',
  },
];

// 5 大核心主題
const topics = [
  {
    t: 'AI 時代的職涯戰略',
    fit: '對職涯感到焦慮 / 想轉型者；初階工程師、初階資料分析師、在校生、新鮮人',
    points: ['掌握生成式 AI 與自動化趨勢下的職場變革', '哪些工作型態被取代、哪些新機會正在崛起', '設計屬於自己的「AI 時代個人成長藍圖」'],
    win: '理解 AI 自動化影響 · 找到個人定位 · 設計轉型地圖',
  },
  {
    t: '資料工程職涯入門與轉職路徑規劃',
    fit: '欲轉職資料領域的新鮮人、跨領域進入科技業者、對資料工程感興趣的學員',
    points: ['資料工程產業機會解析與實際進入路線', 'DE 職責、技能組成、進階路線（雲端、平台、DataOps）', '真實案例拆解成功轉職的策略'],
    win: 'DE 職涯生態圖 · 個人化轉職路線 · 作品集 × 技術 × 商業比例',
  },
  {
    t: 'AI 技能展現與工具應用 — 職場升級攻略',
    fit: '想提升職場競爭力的上班族、初階技術人、產品經理、數位工作者',
    points: ['在職場中實際應用 AI 工具（ChatGPT / NotebookLM / 自動化）', '「AI 技能 × 實戰應用 × 影響力加速」成長飛輪模型', '設計 AI 應用策略，成為 AI 素養與自動化人才'],
    win: '辨識 AI 場景 · 工具選擇與導入 · AI 職場價值模型',
  },
  {
    t: '職涯個人品牌設計：打造你在市場上的專屬影響力',
    fit: '技術人、資料人才、斜槓者、自由工作者、自媒體新手',
    points: ['把累積的專業、經驗與個人特色設計成可持續的個人品牌', '品牌定位 / 價值主張 / 內容策略 / 影響力擴張'],
    win: '品牌定位 × 價值主張 · 內容策略 · 把成果變資產',
  },
  {
    t: 'AI Coding 技術導入與應用落地',
    fit: '軟體工程師、AI 應用開發者、技術主管、產品經理、想把 AI 真正導入產品的工程團隊',
    points: ['聚焦如何把生成式 AI 應用從「能跑」帶到「真的能用」', '智能助理與工作流程的選型決策、技能模組的系統化拆解', '成本、效能、品質之間的取捨，搭配企業導入的真實案例'],
    win: '選型時機 · 技能模組系統化 · 成本/效能/品質監控 · 真實落地案例',
  },
];

// 過往合作精選（補：高雄市青年局 AI Agent 職涯講座；立志、樹德標示每年）
const partnerGroups = [
  { icon: 'mic', tag: '講座 / 技術分享', items: ['高雄市青年局 AI Agent 職涯講座（2026）', 'Alpha Camp 高雄講座 ×2', '中央大學產學技術分享', '緯創部門技術分享會', '樹德科大職涯講座（2024 起每年）', '立志中學職涯講座（2024 起每年）'] },
  { icon: 'building-community', tag: '企業內訓', items: ['緯創數據工程學院（2023–2025）', '緯創 DataOps 與資料治理', '緯創開發者分享會（2023–2024）', '全齡發展協會 AI 技術應用'] },
  { icon: 'card-stack', tag: '作品集 / 專題陪跑', items: ['TibaMe 雲端遠距在職班（2026 –）', 'AAPD 職涯陪跑教練（2026 –）', '無限學院（2024 –）/ nschool 職能學院（2023 –）', '學米 / 六角 / Alpha Camp（2023 –）'] },
  { icon: 'radio-tower', tag: '主持 / 大型線上', items: ['PyCon TW 2024 議程主持', '水球軟體學院 技術研討會 2025', 'TibaMe 資料工程師職涯線上分享（2025 · 2026）', 'TibaMe 緯育 線上分享會 2025'] },
];

// 近期演講合作明細（原頁全數保留，新增場次標 isNew）
const talks = [
  { t: 'Alpha Camp 高雄合作講座：尋找自我的動力 — 資料 × 軟體 × 傳授的職涯旅程', d: '2024/03/24' },
  { t: 'Alpha Camp 高雄合作 ＆ 實體履歷健檢：理工職涯工程師在程式領域的發展', d: '2024/05/25' },
  { t: '產學合作 - 中央知識分享：團隊協作的 Python 程式設計', d: '2024/06/25' },
  { t: '產學合作 - 中央知識分享：Docker 容器化技術', d: '2024/09/03' },
  { t: '緯創數位轉型技術分享會：生成式 AI 簡報工具優劣', d: '2024/09/18' },
  { t: 'PyCon TW 2024 一般議程主持人 / Open Space — 南部的程式職涯發展', d: '2024/09/22' },
  { t: '島島阿學 行銷讀書會：電子報類型分析與 Kit 平台優劣', d: '2025/10/18' },
  { t: '樹德科大職涯講座：人工智慧與資訊科技 — 新興技術中的職涯機遇', d: '2025/10/21' },
  { t: '立志中學職涯講座：人工智慧與資訊科技 — 技術、升學與職涯的交會', d: '2024/11/11 · 2025/11/11' },
  { t: '台灣實驗教育合作社線上講座：從 Python 開發到資料科學', d: '2025/11/23' },
  { t: 'TibaMe 資料工程師職涯與轉職策略線上分享', d: '2025 · 2026' },
  { t: '高雄市青年局 AI Agent 職涯講座', d: '2026', isNew: true },
];

const certs = PROFILE.certs.map((c) => c.label);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={pageTitle} description={pageDescription} type="website" />
  </head>
  <body class="pv">
    <V2Nav chatHref={FREE_CHAT_URL} hall="HALL 05" />

    <!-- ================= HERO ================= -->
    <header class="dark grain sv-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap sv-hero-grid">
        <div>
          <div class="sv-tag">SCENE 05 <b>企業與大專院校講座</b></div>
          <h1>邀請 Dex <br /><em>講座</em> / 內訓 / <em>課程</em></h1>
          <p class="sv-hero-sub">Python <span>×</span> 資料工程 <span>×</span> AI 應用 <span>×</span> 職涯轉型</p>
          <div class="scene">
            <div class="scene-label">SCENE · 我的教學</div>
            <div class="scene-line sv-quote-zh">「{PROFILE.quotes.instructor}」</div>
          </div>
          <div class="sv-cred">
            <span><b>{PROFILE.stats.talks}+</b>主持與講座</span>
            <span><b>{PROFILE.stats.studentsCoached}+</b>轉職學員指導</span>
            <span>現職 AI 技術總監</span>
          </div>
          <div class="ctas">
            <a class="btn btn-amber" href={MAIL_URL}>寫信邀約講座 →</a>
            <a class="btn btn-line" href="#signature">看通用講座方案</a>
          </div>
        </div>

        <aside class="sv-slate" aria-label="通用講座摘要">
          <div class="sv-slate-top" aria-hidden="true"></div>
          <div class="sv-slate-k"><span>NOW SHOWING</span><span>2 VERSIONS</span></div>
          <span class="sv-slate-stamp" aria-hidden="true">開放<br />邀約中</span>
          <h2>通用講座</h2>
          <dl>
            <div><dt>主標</dt><dd>職涯經驗與 AI 發展應用<small>一個非本科 AI 工程師的路，和未來即將進入的世界</small></dd></div>
            <div><dt>A 版</dt><dd>AI 實戰版<small>兩段現場示範</small></dd></div>
            <div><dt>B 版</dt><dd>職涯規劃版<small>地圖 → 羅盤 → 路線 → 90 天</small></dd></div>
            <div><dt>時長</dt><dd>2 小時（可客製）</dd></div>
          </dl>
          <div class="sv-slate-foot">
            <a class="btn btn-cta" href="#signature">看講座流程 →</a>
          </div>
        </aside>
      </div>
    </header>

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= REEL 01 適合誰 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 01 · 適合誰</div>
          <h2>你是哪一種主辦單位？</h2>
        </div>
        <div class="sv-grid sv-grid-4">
          {hosts.map((h) => (
            <div class="sv-card">
              <span class="sv-icon" aria-hidden="true"><Icon name={`pixelarticons:${h.icon}`} width={26} height={26} /></span>
              <h3>{h.t}</h3>
              <div class="sv-meta">{h.sub}</div>
              <p>{h.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= REEL 02 怎麼進行 ================= -->
    <section class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 02 · 怎麼進行</div>
          <h2>為什麼選 Dex 來教學？</h2>
        </div>
        <div class="sv-grid sv-grid-4">
          {whyDex.map((w) => (
            <div class="sv-card sv-card-d">
              <span class="sv-icon" aria-hidden="true"><Icon name={`pixelarticons:${w.icon}`} width={26} height={26} /></span>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          ))}
        </div>

        <h3 class="sv-sub-h">數據成果</h3>
        <div class="sv-stats" style="margin-top:20px;">
          {stats.map((s) => (
            <div><b>{s.n}</b><strong>{s.t}</strong><span>{s.d}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= REEL 03 方案 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div id="signature" class="sv-head">
          <div class="sv-reel">REEL 03 · 方案</div>
          <h2>通用講座：同一部片，兩種剪法</h2>
          <p class="sub">〈{SIGNATURE_TITLE}〉—— 依場合選 AI 實戰版或職涯規劃版，各 2 小時。</p>
        </div>
        <div class="sv-signature">
          {signatureTalks.map((tk, i) => (
            <article class="sv-talk">
              <span class="tape tape-l" aria-hidden="true"></span>
              <span class="tape tape-r" aria-hidden="true"></span>
              <div class="case-sheet"><span>CALL SHEET · 講座流程</span><span>{i === 0 ? 'CUT A' : 'CUT B'}</span></div>
              <span class="sv-talk-ver">{tk.ver}</span>
              <h3>〈{SIGNATURE_TITLE}〉</h3>
              <p class="sv-talk-axis">{tk.axis}</p>
              <div class="sv-talk-meta">{tk.meta.map((m) => <span>{m}</span>)}</div>
              <ol class="sv-rundown">
                {tk.rundown.map((r) => (
                  <li class={r.demo ? 'is-demo' : undefined}>
                    <time>{r.time}</time>
                    <b>{r.t}{r.demo && <span class="sv-demo">LIVE</span>}</b>
                    <p>{r.d}</p>
                  </li>
                ))}
              </ol>
              <p class="sv-talk-fit"><b>適合：</b>{tk.fit}</p>
            </article>
          ))}
        </div>

        <h3 class="sv-sub-h">5 大核心主題</h3>
        <p class="sv-sub-p">每個主題均可客製化時長、深度與案例 — 來信附主辦單位、對象與期待，會給課綱提案。</p>
        <div class="sv-rows">
          {topics.map((tp, i) => (
            <div class="sv-topic">
              <span class="sv-topic-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{tp.t}</h3>
                <p class="sv-topic-fit">適合：{tp.fit}</p>
                <ul class="sv-list">{tp.points.map((p) => <li>{p}</li>)}</ul>
                <div class="sv-topic-win"><span>學員收穫 ›</span>{tp.win}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="sv-tip">
          <span>也可 <b>客製化主題</b>：結合貴單位需求設計 — 來信附對象 / 時長 / 期待收穫，我會給課綱提案。</span>
          <a class="btn btn-cta btn-sm" href={MAIL_URL}>寫信提需求 →</a>
        </div>
      </div>
    </section>

    <!-- ================= REEL 04 實績 ================= -->
    <section class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 04 · 實績</div>
          <h2>過往合作精選</h2>
        </div>
        <div class="sv-grid sv-grid-2">
          {partnerGroups.map((g) => (
            <div class="sv-card sv-card-d sv-group">
              <h3><Icon name={`pixelarticons:${g.icon}`} width={22} height={22} />{g.tag}</h3>
              <ul class="sv-list">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>

        <h3 class="sv-sub-h">近期演講合作明細</h3>
        <ul class="sv-talks">
          {talks.map((t) => (
            <li class={t.isNew ? 'is-new' : undefined}><span>{t.t}</span><time>{t.d}</time></li>
          ))}
        </ul>

        <div class="sv-certs" aria-label="專業背景">
          <span>專業背景 · CERTIFIED</span>
          {certs.map((c) => <b>{c}</b>)}
          <p><b style="background:none;border:0;padding:0;">正職：</b>{PROFILE.careerOrgs.join(' · ')}</p>
        </div>
      </div>
    </section>

    <V2ServiceCrossLink current="instructor" />
    <V2ContactCTA variant="instructor" chatHref={FREE_CHAT_URL} />
    <V2Footer />
    <NewsletterFloatingCTA />
  </body>
</html>
