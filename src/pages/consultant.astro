---
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import TopBar from '../components/blocks/TopBar.astro';
import Footer from '../components/blocks/Footer.astro';
import ContactCTA from '../components/blocks/ContactCTA.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import { SITE_TITLE } from '../consts';
import { PROFILE } from '../data/profile';

const pageTitle = `AI 與資料自動化技術導入與企業內訓 ｜ ${SITE_TITLE}`;
const pageDescription = '技術顧問 × 資料工程 × AI 應用 × 數位行銷。10 年技術職涯（Hamastar / 水球 / 緯創 / LINE Bank / TutorABC / Micron）+ 1 年行銷成長 — 跨領域顧問，給你做得起的解法，不給做不到的最佳實踐。';

const C = {
  bg: '#FBFAF7', bgSoft: '#F4F1EB', ink: '#1F1B16', ink2: '#3D3A33',
  muted: '#6B6557', faint: '#A39C8C', rule: '#E8E2D4',
  accent: '#5391FF', accentDark: '#2F6FE0', accentSoft: '#EAF1FF',
  warm: '#D97706', warmSoft: '#FEF3E7', card: '#FFFFFF',
};
const sans = '"Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif';
const serif = '"Noto Serif TC", "Source Han Serif TC", serif';

// 三個階段
const stages = [
  { tag: '釐清', t: '不確定怎麼開始', d: '單次諮詢 1–2 hr', deliver: '一份決策建議書' },
  { tag: '執行', t: '有目標但跑不動', d: '1–3 個月專案陪跑', deliver: 'Weekly sync + 階段交付' },
  { tag: '長期', t: '需要長期軍師', d: '半年起長期顧問', deliver: '每月 1–2 次深度 sync' },
];

// 5 個痛點
const painpoints = [
  { n: '01', t: '想用資料但不知從哪開始 / 已開始但跑不順', d: '資料盤點 × ROI 評估 × Pipeline 六階段全包' },
  { n: '02', t: '想導入 AI 被 enterprise 報價嚇到', d: 'LLM 應用 / RAG / Agent，cost 壓到 enterprise 的 1/10' },
  { n: '03', t: 'Excel 文化卡組織轉型 / 跨部門資料沒打通', d: '第一個 dashboard 怎麼開、何時升 DW、命名與權限' },
  { n: '04', t: '技術做得起卻跑不久 / Tech Debt 滾雪球', d: '架構選型 × Code Review × CI/CD × 3–12 個月迭代計畫' },
  { n: '05', t: '有產品但賣不動 / 有受眾但沒轉化', d: 'TOFU / MOFU / BOFU 漏斗 × SEO × 內容矩陣 × 行銷自動化' },
];

// 對比表
const compare = [
  { theirs: '「業界最佳實踐」', mine: '「以你規模做得起的做法」' },
  { theirs: '大型架構圖讓 CTO 看完點頭', mine: '能讓 1 人團隊跑得起來的 step-by-step' },
  { theirs: '報價嚇人的 enterprise 工具', mine: '免費 / 低成本 + 知道何時該升級' },
  { theirs: '工程語言溝通', mine: '把工程翻成業務語言、把業務翻成工程語言' },
  { theirs: '純技術 OR 純行銷', mine: '跨領域 — 技術 + 行銷 + 教學三條腿一起走' },
];

// 7 大顧問服務
const services = [
  { icon: '🏗', t: '技術顧問', d: '架構設計 / 技術選型 / Code Review / 工程文化 / Tech Debt 評估' },
  { icon: '🧪', t: '資料工程 / 分析', d: 'Pipeline 建置、ETL/ELT、資料品質、Dashboard、DE 人才養成' },
  { icon: '🔄', t: '資料轉型', d: '業務 → 資料翻譯、跨部門整合、ROI 評估、組織文化' },
  { icon: '🤖', t: 'AI 落地', d: 'LLM / RAG / Agent 應用、cost 控制、AI 工具導入內訓' },
  { icon: '📈', t: '數位行銷', d: 'SEO / 內容漏斗 / 自動化 / 社群成長 / A/B test' },
  { icon: '🎙', t: '品牌行銷', d: '個人品牌定位、多平台內容系統、內容自動化' },
  { icon: '🧭', t: 'Data & AI 職涯', d: '技術路徑規劃、作品集設計、履歷面試、PBL 陪跑' },
];

// 合作方式
const formats = [
  { f: '單次諮詢', fit: '釐清方向、找決策方案', dur: '1–2 hr', deliver: '1 份決策建議書' },
  { f: '健檢專案', fit: '想知道現況有沒有問題', dur: '2–4 週', deliver: '技術 / 資料 / 行銷健檢報告' },
  { f: '專案陪跑', fit: '1–3 個月衝一個目標', dur: '月度', deliver: 'Weekly sync + 階段交付' },
  { f: '長期顧問', fit: '半年起、跟著公司成長', dur: '季 / 半年', deliver: '每月 1–2 次 sync + ad-hoc' },
];

// 信任符號
const trust = [
  { tag: '🏢 企業內訓 & 系列課程', items: ['緯創資通數據工程學院', '緯創 DataOps 與資料治理', '緯創開發者分享會', '全齡發展協會 AI 應用'] },
  { tag: '💼 諮詢業師 / 教練', items: ['TibaMe 雲端遠距在職班（2026 –）', 'AAPD 職涯陪跑教練（2026 –）', '無限學院（2024 –）', 'nschool 職能學院（2023 –）', '學米 / 六角 / Alpha Camp（2023 –）'] },
  { tag: '📋 履歷檢診 / 諮詢支持', items: ['Alpha Camp 實體履歷健檢', 'Cake 履歷健檢', '104 Giver', 'CDA · Life Coach 認證'] },
  { tag: '🚀 實作成績', items: ['緯創 ESG 全球工廠數據平台', '水球軟體學院 1 月百萬營收', 'TibaMe 學員手冊（公開資源）', 'Mentoroad 導生門路 AI 平台'] },
];

const certs = PROFILE.certs.map(c => c.label);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={pageTitle} description={pageDescription} type="website" />
    <style is:global>
      body {
        margin: 0;
        background: #FBFAF7;
        color: #1F1B16;
        font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", system-ui, sans-serif;
      }
      a { color: inherit; }
    </style>
  </head>
  <body>
    <div style={`background:${C.bg};color:${C.ink};font-family:${sans};min-height:100vh;`}>

      <TopBar activePage="技術顧問" logoVariant="minimal" />

      {/* ===================== Hero ===================== */}
      <section style="padding:80px 56px 60px;max-width:1100px;margin:0 auto;text-align:center;">
        <div style={`display:inline-flex;align-items:center;gap:10px;background:${C.ink};color:${C.bg};padding:6px 16px;border-radius:6px;font-family:${sans};font-weight:700;letter-spacing:2px;font-size:12px;margin-bottom:24px;`}>
          <span style={`width:7px;height:7px;border-radius:50%;background:${C.warm};`}></span>
          SCENE · AI 和資料自動化技術導入與企業內訓
        </div>

        <h1 style={`font-family:${sans};font-size:60px;font-weight:800;letter-spacing:-1.5px;line-height:1.18;margin:0 0 22px;`}>
          把資料變<span style={`color:${C.accent};`}>決策</span>，<br/>
          把 AI 變<span style={`color:${C.warm};`}>日常</span>
        </h1>

        <p style={`font-family:${sans};font-size:15px;color:${C.ink2};margin:0 0 22px;font-weight:600;letter-spacing:0.2px;`}>
          資料自動化工程 × Data & AI 應用 × 數位行銷 × 職涯教練
        </p>

        <p style={`font-family:${serif};font-size:17px;color:${C.muted};line-height:1.95;max-width:720px;margin:0 auto 18px;font-style:italic;`}>
          「{PROFILE.quotes.consultant}」
        </p>
        <p style={`font-family:${sans};font-size:13.5px;color:${C.muted};max-width:720px;margin:0 auto;line-height:1.85;`}>
          10 年技術職涯（{PROFILE.careerOrgs.join(' / ')}）+ 1 年行銷成長 — 跨領域顧問，給你做得起的解法，不給做不到的最佳實踐。
        </p>
      </section>

      {/* ===================== 你正在哪個階段 ===================== */}
      <section style="padding:40px 56px 80px;max-width:1100px;margin:0 auto;">
        <h2 style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.ink};letter-spacing:-0.6px;text-align:center;margin:0 0 36px;`}>
          你正在哪個階段？
        </h2>
        <div style="display:grid;grid-template-columns:repeat(3, 1fr);gap:20px;">
          {stages.map((s) => (
            <div style={`padding:30px 26px;background:${C.card};border:1px solid ${C.rule};border-radius:16px;text-align:center;`}>
              <div style={`display:inline-block;padding:6px 14px;background:${C.warm};color:#fff;border-radius:6px;font-family:${sans};font-weight:700;letter-spacing:2px;font-size:11px;margin-bottom:18px;`}>{s.tag}</div>
              <h3 style={`font-family:${sans};font-size:19px;font-weight:700;color:${C.ink};letter-spacing:-0.3px;margin:0 0 14px;line-height:1.4;`}>{s.t}</h3>
              <p style={`font-family:${sans};font-size:14px;color:${C.ink2};margin:0 0 6px;font-weight:600;`}>{s.d}</p>
              <p style={`font-family:${serif};font-size:13px;color:${C.muted};font-style:italic;margin:0;`}>{s.deliver}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ===================== 5 個痛點 ===================== */}
      <section style={`background:${C.bgSoft};padding:80px 56px;`}>
        <div style="max-width:1000px;margin:0 auto;">
          <h2 style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.ink};letter-spacing:-0.6px;text-align:center;margin:0 0 14px;`}>
            5 個我最常被找的痛點
          </h2>
          <p style={`font-family:${serif};font-size:14px;color:${C.muted};text-align:center;font-style:italic;margin:0 0 40px;`}>
            如果以下任一個讓你眉頭一皺，可以直接約 30 分鐘對焦。
          </p>
          <div style="display:flex;flex-direction:column;gap:14px;">
            {painpoints.map((p) => (
              <div style={`display:grid;grid-template-columns:80px 1fr;gap:24px;align-items:start;padding:24px 26px;background:${C.card};border:1px solid ${C.rule};border-radius:14px;`}>
                <div style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.warm};letter-spacing:-1px;line-height:1;`}>{p.n}</div>
                <div>
                  <h3 style={`font-family:${sans};font-size:17px;font-weight:700;color:${C.ink};letter-spacing:-0.2px;margin:0 0 8px;line-height:1.5;`}>{p.t}</h3>
                  <p style={`font-family:${serif};font-size:14px;color:${C.muted};line-height:1.85;margin:0;`}>{p.d}</p>
                </div>
              </div>
            ))}
          </div>
          <div style={`margin-top:28px;padding:22px;background:${C.warmSoft};border-radius:14px;font-family:${sans};font-size:14px;color:${C.ink};text-align:center;font-weight:600;`}>
            💡 不確定哪個是你的？先約一次<span style={`color:${C.warm};font-weight:700;`}>免費 30 分鐘對焦</span>，幫你選對切入點。
          </div>
        </div>
      </section>

      {/* ===================== 我跟其他顧問的差別 ===================== */}
      <section style="padding:80px 56px;max-width:1100px;margin:0 auto;">
        <h2 style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.ink};letter-spacing:-0.6px;text-align:center;margin:0 0 40px;`}>
          我跟其他顧問的差別
        </h2>
        <div style={`overflow:hidden;border:1px solid ${C.rule};border-radius:14px;`}>
          <div style={`display:grid;grid-template-columns:1fr 1fr;background:${C.bgSoft};font-family:${sans};font-size:13px;font-weight:700;color:${C.muted};letter-spacing:1.5px;`}>
            <div style="padding:16px 24px;">別人通常給的</div>
            <div style={`padding:16px 24px;color:${C.warm};border-left:1px solid ${C.rule};`}>我給的</div>
          </div>
          {compare.map((c, i) => (
            <div style={`display:grid;grid-template-columns:1fr 1fr;background:${i % 2 === 0 ? C.card : C.bgSoft};font-family:${serif};font-size:15px;line-height:1.85;`}>
              <div style={`padding:18px 24px;color:${C.muted};font-style:italic;`}>{c.theirs}</div>
              <div style={`padding:18px 24px;color:${C.ink};border-left:1px solid ${C.rule};font-weight:600;font-style:normal;font-family:${sans};font-size:14.5px;`}>{c.mine}</div>
            </div>
          ))}
        </div>
      </section>

      {/* ===================== 7 大顧問服務 ===================== */}
      <section style={`background:${C.ink};color:${C.bg};padding:80px 56px;`}>
        <div style="max-width:1100px;margin:0 auto;">
          <h2 style={`font-family:${sans};font-size:32px;font-weight:800;letter-spacing:-0.6px;text-align:center;margin:0 0 40px;color:#fff;`}>
            7 大顧問服務
          </h2>
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:18px;">
            {services.map((s) => (
              <div style={`padding:24px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;`}>
                <div style="font-size:30px;margin-bottom:14px;">{s.icon}</div>
                <h3 style={`font-family:${sans};font-size:17px;font-weight:700;color:#fff;letter-spacing:-0.2px;margin:0 0 10px;`}>{s.t}</h3>
                <p style={`font-family:${serif};font-size:14px;color:rgba(255,255,255,0.72);line-height:1.85;margin:0;`}>{s.d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* ===================== 合作方式 ===================== */}
      <section style="padding:80px 56px;max-width:1100px;margin:0 auto;">
        <h2 style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.ink};letter-spacing:-0.6px;text-align:center;margin:0 0 40px;`}>
          合作方式
        </h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;">
          {formats.map((f) => (
            <div style={`padding:26px;background:${C.card};border:1px solid ${C.rule};border-radius:14px;`}>
              <h3 style={`font-family:${sans};font-size:18px;font-weight:700;color:${C.ink};letter-spacing:-0.3px;margin:0 0 14px;border-bottom:1px dashed ${C.rule};padding-bottom:12px;`}>{f.f}</h3>
              <div style={`font-family:${sans};font-size:13px;color:${C.muted};margin-bottom:6px;`}><strong style={`color:${C.ink2};`}>適合：</strong>{f.fit}</div>
              <div style={`font-family:${sans};font-size:13px;color:${C.muted};margin-bottom:6px;`}><strong style={`color:${C.ink2};`}>時長：</strong>{f.dur}</div>
              <div style={`font-family:${sans};font-size:13px;color:${C.muted};`}><strong style={`color:${C.ink2};`}>交付：</strong>{f.deliver}</div>
            </div>
          ))}
        </div>
      </section>

      {/* ===================== 合作過的單位 / 實作成績 ===================== */}
      <section style={`background:${C.bgSoft};padding:80px 56px;`}>
        <div style="max-width:1100px;margin:0 auto;">
          <h2 style={`font-family:${sans};font-size:32px;font-weight:800;color:${C.ink};letter-spacing:-0.6px;text-align:center;margin:0 0 40px;`}>
            合作過的單位 / 實作成績
          </h2>
          <div style="display:grid;grid-template-columns:repeat(2, 1fr);gap:20px;margin-bottom:32px;">
            {trust.map((g) => (
              <div style={`padding:24px;background:${C.card};border:1px solid ${C.rule};border-radius:14px;`}>
                <h3 style={`font-family:${sans};font-size:14px;font-weight:700;color:${C.ink};letter-spacing:0.5px;margin:0 0 14px;`}>{g.tag}</h3>
                <ul style={`list-style:none;padding:0;margin:0;font-family:${sans};font-size:13.5px;color:${C.ink2};line-height:2;`}>
                  {g.items.map((it) => <li>· {it}</li>)}
                </ul>
              </div>
            ))}
          </div>
          <div style={`padding:24px;background:${C.card};border:1px solid ${C.rule};border-radius:14px;text-align:center;`}>
            <h3 style={`font-family:${sans};font-size:13px;font-weight:700;color:${C.muted};letter-spacing:1.5px;margin:0 0 14px;`}>專業證照</h3>
            <div style="display:flex;flex-wrap:wrap;gap:8px;justify-content:center;">
              {certs.map((c) => (
                <span style={`padding:7px 14px;background:${C.bgSoft};color:${C.ink};border-radius:999px;font-family:${sans};font-size:12.5px;font-weight:600;`}>{c}</span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <ContactCTA variant="consultant" />

      <Footer taglineComma="full" />

    </div>

    <NewsletterFloatingCTA />
  </body>
</html>
