---
// AI 與資料自動化導入（v2 暖光放映廳版）
// 版型（三服務頁共用）：hero → 適合誰 → 怎麼進行 → 方案 → 實績 → 其他服務 → CTA
// 三幕劇轉型法、實戰案例：自 preview/home.astro 精簡搬入
import { Icon } from 'astro-icon/components';
import BaseHead from '../components/BaseHead.astro';
import SEO from '../components/SEO.astro';
import V2Nav from '../components/v2/V2Nav.astro';
import V2Footer from '../components/v2/V2Footer.astro';
import V2ContactCTA from '../components/v2/V2ContactCTA.astro';
import V2ServiceCrossLink from '../components/v2/V2ServiceCrossLink.astro';
import NewsletterFloatingCTA from '../components/blocks/NewsletterFloatingCTA.astro';
import { SITE_TITLE } from '../consts';
import { PROFILE } from '../data/profile';
import '../styles/v2.css';
import '../styles/v2-services.css';

const FREE_CHAT_URL = 'https://calendly.com/daydreamisexp/meet-with-me';
const MAIL_URL = `mailto:${PROFILE.email}?subject=顧問合作洽詢`;

const pageTitle = `AI 與資料自動化技術導入與企業內訓 ｜ ${SITE_TITLE}`;
const pageDescription = '技術顧問 × 資料工程 × AI 應用 × 數位行銷。10 年技術職涯（Hamastar / 水球 / 緯創 / LINE Bank / TutorABC / Micron）+ 1 年行銷成長 — 跨領域顧問，給你做得起的解法，不給做不到的最佳實踐。';

// 三個階段
const stages = [
  { tag: '釐清', t: '不確定怎麼開始', d: '單次諮詢 1–2 hr', deliver: '一份決策建議書' },
  { tag: '執行', t: '有目標但跑不動', d: '1–3 個月專案陪跑', deliver: 'Weekly sync + 階段交付' },
  { tag: '長期', t: '需要長期軍師', d: '半年起長期顧問', deliver: '每月 1–2 次深度 sync' },
];

// 5 個痛點
const painpoints = [
  { n: '01', t: '想用資料但不知從哪開始 / 已開始但跑不順', d: '資料盤點 × ROI 評估 × Pipeline 六階段全包' },
  { n: '02', t: '想導入 AI 被 enterprise 報價嚇到', d: 'LLM 應用 / RAG / Agent，cost 壓到 enterprise 的 1/10' },
  { n: '03', t: 'Excel 文化卡組織轉型 / 跨部門資料沒打通', d: '第一個 dashboard 怎麼開、何時升 DW、命名與權限' },
  { n: '04', t: '技術做得起卻跑不久 / Tech Debt 滾雪球', d: '架構選型 × Code Review × CI/CD × 3–12 個月迭代計畫' },
  { n: '05', t: '有產品但賣不動 / 有受眾但沒轉化', d: 'TOFU / MOFU / BOFU 漏斗 × SEO × 內容矩陣 × 行銷自動化' },
];

// 對比表
const compare = [
  { theirs: '「業界最佳實踐」', mine: '「以你規模做得起的做法」' },
  { theirs: '大型架構圖讓 CTO 看完點頭', mine: '能讓 1 人團隊跑得起來的 step-by-step' },
  { theirs: '報價嚇人的 enterprise 工具', mine: '免費 / 低成本 + 知道何時該升級' },
  { theirs: '工程語言溝通', mine: '把工程翻成業務語言、把業務翻成工程語言' },
  { theirs: '純技術 OR 純行銷', mine: '跨領域 — 技術 + 行銷 + 教學三條腿一起走' },
];

// 7 大顧問服務（pixelarticons）
const services = [
  { icon: 'building-community', t: '技術顧問', d: '架構設計 / 技術選型 / Code Review / 工程文化 / Tech Debt 評估' },
  { icon: 'server', t: '資料工程 / 分析', d: 'Pipeline 建置、ETL/ELT、資料品質、Dashboard、DE 人才養成' },
  { icon: 'repeat', t: '資料轉型', d: '業務 → 資料翻譯、跨部門整合、ROI 評估、組織文化' },
  { icon: 'robot', t: 'AI 落地', d: 'LLM / RAG / Agent 應用、cost 控制、AI 工具導入內訓' },
  { icon: 'trending-up', t: '數位行銷', d: 'SEO / 內容漏斗 / 自動化 / 社群成長 / A/B test' },
  { icon: 'mic', t: '品牌行銷', d: '個人品牌定位、多平台內容系統、內容自動化' },
  { icon: 'compass', t: 'Data & AI 職涯', d: '技術路徑規劃、作品集設計、履歷面試、PBL 陪跑' },
];

// 三幕劇轉型法（精簡自首頁）
const acts = [
  { no: 'ACT I', phase: 'PRE-PRODUCTION', title: '前期製作', subtitle: '需求探勘與架構規劃', items: ['利害關係人訪談與現況盤點（流程、資料、系統）', '痛點排序與 ROI 評估，找出阻力最小的切入點', '技術選型與系統架構藍圖'], deliver: ['需求規格書', '系統架構圖', '導入路線圖'] },
  { no: 'ACT II', phase: 'PRODUCTION', title: '拍攝製作', subtitle: 'MVP 開發與迭代驗證', items: ['規格驅動開發（SDD），規格先行、不靠猜', '資料管道、API 串接、LLM／RAG／AI Agent 導入', '短週期 demo，讓使用者邊用邊修'], deliver: ['可運作的 MVP', '測試與驗證報告'] },
  { no: 'ACT III', phase: 'RELEASE', title: '後製與上映', subtitle: '部署、交接與自主維運', items: ['雲端部署、監控與備份機制', '內容與程式分離，非工程背景也改得動', '技術文件、操作手冊與內部教育訓練'], deliver: ['上線系統', '維運文件', '教育訓練'] },
];

// 合作方式
const formats = [
  { f: '單次諮詢', fit: '釐清方向、找決策方案', dur: '1–2 hr', deliver: '1 份決策建議書' },
  { f: '健檢專案', fit: '想知道現況有沒有問題', dur: '2–4 週', deliver: '技術 / 資料 / 行銷健檢報告' },
  { f: '專案陪跑', fit: '1–3 個月衝一個目標', dur: '月度', deliver: 'Weekly sync + 階段交付' },
  { f: '長期顧問', fit: '半年起、跟著公司成長', dur: '季 / 半年', deliver: '每月 1–2 次 sync + ad-hoc' },
];

// 實戰案例（精簡自首頁，通告單樣式）
const cases = [
  {
    org: '臺南左鎮智慧街區 × 左達工作室',
    program: '數位發展部「在地數位種子人才培力方案」入選案',
    title: 'LINE 在地問答與資料洞察系統',
    role: 'AI 與資料整合',
    challenge: '系統要活得比計畫久；在地夥伴沒有工程背景，工程師撤場後誰來維護？',
    approach: 'LINE 官方帳號問答、Webhook 串接、在地知識庫與 KPI 資料層。評估成本與維護性後，這一期刻意不用 LLM，改走關鍵字比對加結構化資料。',
    result: '回覆文字全放進在地夥伴改得動的試算表，工程師離場後仍能自行維運。',
    quote: '一套沒有人維護得了的系統，做得再漂亮都是負債。',
    tags: ['LINE 官方帳號', 'Webhook', '在地知識庫', 'KPI 資料層'],
  },
  {
    org: '合照盟（合作社照顧聯盟）',
    program: '內政部合作社輔導計畫',
    title: 'AI 會議與活動紀錄助手',
    role: 'AI 技術開發',
    challenge: '成員多為兼職，平時沒有紀錄習慣，考核前才回頭大量補件。',
    approach: '錄音與照片上傳 → Whisper 語音轉文字 → LLM 生成摘要、決議與待辦 → 自動套用主管機關格式 → 匯出 Word／PDF 並雲端歸檔。',
    result: '完整交付原始碼與技術文件；與另一個技術團隊重新劃分工、訂定資料交付規格，不重工。',
    quote: '我用你的引擎，你收我的乾淨資料。',
    tags: ['Whisper', 'LLM 摘要', '自動套版', '跨團隊協作'],
  },
];

// 信任符號
const trust = [
  { icon: 'building-community', tag: '企業內訓 & 系列課程', items: ['緯創資通數據工程學院', '緯創 DataOps 與資料治理', '緯創開發者分享會', '全齡發展協會 AI 應用'] },
  { icon: 'teach', tag: '諮詢業師 / 教練', items: ['TibaMe 雲端遠距在職班（2026 –）', 'AAPD 職涯陪跑教練（2026 –）', '無限學院（2024 –）', 'nschool 職能學院（2023 –）', '學米 / 六角 / Alpha Camp（2023 –）'] },
  { icon: 'notes', tag: '履歷檢診 / 諮詢支持', items: ['Alpha Camp 實體履歷健檢', 'Cake 履歷健檢', '104 Giver', 'CDA · Life Coach 認證'] },
  { icon: 'trophy', tag: '實作成績', items: ['緯創 ESG 全球工廠數據平台', '水球軟體學院 1 月百萬營收', 'TibaMe 學員手冊（公開資源）', 'Mentoroad 導生門路 AI 平台'] },
];

const certs = PROFILE.certs.map((c) => c.label);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead />
    <SEO title={pageTitle} description={pageDescription} type="website" />
  </head>
  <body class="pv">
    <V2Nav chatHref={FREE_CHAT_URL} hall="HALL 04" />

    <!-- ================= HERO ================= -->
    <header class="dark grain sv-hero">
      <div class="beam" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>
      <div class="wrap sv-hero-grid">
        <div>
          <div class="sv-tag">SCENE 04 <b>AI 和資料自動化技術導入與企業內訓</b></div>
          <h1>把資料變<em>決策</em>，<br />把 AI 變<em>日常</em></h1>
          <p class="sv-hero-sub">資料自動化工程 <span>×</span> Data &amp; AI 應用 <span>×</span> 數位行銷 <span>×</span> 職涯教練</p>
          <div class="scene">
            <div class="scene-label">SCENE · 我的做法</div>
            <div class="scene-line sv-quote-zh">「{PROFILE.quotes.consultant}」</div>
          </div>
          <div class="sv-cred">
            <span>現職 AI 技術總監</span>
            <span><b>10</b>年技術職涯</span>
            <span><b>1</b>年行銷成長</span>
          </div>
          <p class="sv-hero-note">10 年技術職涯（{PROFILE.careerOrgs.join(' / ')}）+ 1 年行銷成長 — 跨領域顧問，給你做得起的解法，不給做不到的最佳實踐。</p>
          <div class="ctas">
            <a class="btn btn-amber" href={FREE_CHAT_URL} target="_blank" rel="noopener noreferrer">免費 30 分鐘對焦 →</a>
            <a class="btn btn-line" href={MAIL_URL}>寫信給 Dex</a>
          </div>
        </div>

        <aside class="sv-slate" aria-label="導入方法摘要">
          <div class="sv-slate-top" aria-hidden="true"></div>
          <div class="sv-slate-k"><span>PRODUCTION NOTES</span><span>3 ACTS</span></div>
          <h2>三幕劇轉型法</h2>
          <dl>
            {acts.map((a) => (
              <div><dt>{a.no}</dt><dd>{a.title}<small>{a.subtitle}</small></dd></div>
            ))}
          </dl>
          <div class="sv-slate-foot">
            <a class="btn btn-cta" href="#acts">看導入流程 →</a>
          </div>
        </aside>
      </div>
    </header>

    <div class="sprocket" aria-hidden="true"></div>

    <!-- ================= REEL 01 適合誰 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 01 · 適合誰</div>
          <h2>你正在哪個階段？</h2>
        </div>
        <div class="sv-grid sv-grid-3">
          {stages.map((s, i) => (
            <div class="sv-card">
              <span class="sv-no">{`STAGE 0${i + 1} · ${s.tag}`}</span>
              <h3>{s.t}</h3>
              <p><b>{s.d}</b></p>
              <span class="sv-foot">交付：{s.deliver}</span>
            </div>
          ))}
        </div>

        <h3 class="sv-sub-h">5 個我最常被找的痛點</h3>
        <p class="sv-sub-p">如果以下任一個讓你眉頭一皺，可以直接約 30 分鐘對焦。</p>
        <div class="sv-rows">
          {painpoints.map((p) => (
            <div class="sv-row">
              <span class="sv-row-n">{p.n}</span>
              <div><h3>{p.t}</h3><p>{p.d}</p></div>
            </div>
          ))}
        </div>
        <div class="sv-tip">
          <span>不確定哪個是你的？先約一次<b>免費 30 分鐘對焦</b>，幫你選對切入點。</span>
          <a class="btn btn-cta btn-sm" href={FREE_CHAT_URL} target="_blank" rel="noopener noreferrer">約 30 分鐘對焦 →</a>
        </div>
      </div>
    </section>

    <!-- ================= REEL 02 怎麼進行 ================= -->
    <section class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 02 · 怎麼進行</div>
          <h2>7 大顧問服務</h2>
        </div>
        <div class="sv-grid sv-grid-4">
          {services.map((s) => (
            <div class="sv-card sv-card-d">
              <span class="sv-icon" aria-hidden="true"><Icon name={`pixelarticons:${s.icon}`} width={26} height={26} /></span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>

        <h3 id="acts" class="sv-sub-h">三幕劇轉型法</h3>
        <p class="sv-sub-p">把數位轉型當成一部電影來製作：先有劇本和分鏡，再開拍，最後交到你手上上映。每一幕都有明確的工作項目與交付物。</p>
        <div class="act-grid">
          {acts.map((a) => (
            <div class="act">
              <div class="act-strip" aria-hidden="true"></div>
              <div class="act-no">{a.no} · {a.phase}</div>
              <h3>{a.title}</h3>
              <div class="act-role">{a.subtitle}</div>
              <ul class="act-items">{a.items.map((t) => <li>{t}</li>)}</ul>
              <div class="act-deliver">
                <span>交付物</span>
                {a.deliver.map((d) => <b>{d}</b>)}
              </div>
            </div>
          ))}
        </div>
        <p class="act-line">導演的工作不是自己演完整部片，<br />而是讓劇組在<em>導演離場之後</em>，依然拍得下去。</p>
      </div>
    </section>

    <!-- ================= REEL 03 方案 ================= -->
    <section class="paper sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 03 · 方案</div>
          <h2>合作方式</h2>
        </div>
        <div class="sv-grid sv-grid-4">
          {formats.map((f, i) => (
            <div class="sv-card sv-format">
              <span class="sv-no">{`PLAN 0${i + 1}`}</span>
              <h3>{f.f}</h3>
              <dl>
                <div><dt>適合</dt><dd>{f.fit}</dd></div>
                <div><dt>時長</dt><dd>{f.dur}</dd></div>
                <div><dt>交付</dt><dd>{f.deliver}</dd></div>
              </dl>
            </div>
          ))}
        </div>

        <h3 class="sv-sub-h">我跟其他顧問的差別</h3>
        <div class="sv-compare" role="table" aria-label="我跟其他顧問的差別">
          <div class="sv-compare-row sv-compare-head" role="row"><div role="columnheader">別人通常給的</div><div role="columnheader">我給的</div></div>
          {compare.map((c) => (
            <div class="sv-compare-row" role="row"><div role="cell">{c.theirs}</div><div role="cell">{c.mine}</div></div>
          ))}
        </div>
      </div>
    </section>

    <!-- ================= REEL 04 實績 ================= -->
    <section id="cases" class="dark grain sv-sec">
      <div class="wrap">
        <div class="sv-head">
          <div class="sv-reel">REEL 04 · 實績</div>
          <h2>數位轉型與 AI 導入實戰案例</h2>
          <p class="sub">兩個正在地方與非營利組織現場運作的系統 —— 從需求訪談、開發到交接，全程參與。</p>
        </div>
        <div class="case-grid">
          {cases.map((c, i) => (
            <article class="case">
              <span class="tape tape-l" aria-hidden="true"></span>
              <span class="tape tape-r" aria-hidden="true"></span>
              <div class="case-sheet"><span>CALL SHEET · 通告單</span><span>CASE {String(i + 1).padStart(2, '0')}</span></div>
              <span class="case-stamp" aria-hidden="true">已交付<br />上映中</span>
              <div class="case-org">{c.org}</div>
              <div class="case-meta">{c.program} · 我的角色：{c.role}</div>
              <h3>{c.title}</h3>
              <dl class="case-rows">
                <div><dt>挑戰</dt><dd>{c.challenge}</dd></div>
                <div><dt>做法</dt><dd>{c.approach}</dd></div>
                <div><dt>成果</dt><dd>{c.result}</dd></div>
              </dl>
              <blockquote>「{c.quote}」</blockquote>
              <div class="case-tags">{c.tags.map((t) => <span>{t}</span>)}</div>
            </article>
          ))}
        </div>

        <h3 class="sv-sub-h">合作過的單位 / 實作成績</h3>
        <div class="sv-grid sv-grid-2">
          {trust.map((g) => (
            <div class="sv-card sv-card-d sv-group">
              <h3><Icon name={`pixelarticons:${g.icon}`} width={22} height={22} />{g.tag}</h3>
              <ul class="sv-list">{g.items.map((it) => <li>{it}</li>)}</ul>
            </div>
          ))}
        </div>

        <div class="sv-certs" aria-label="專業證照">
          <span>專業證照 · CERTIFIED</span>
          {certs.map((c) => <b>{c}</b>)}
        </div>
      </div>
    </section>

    <V2ServiceCrossLink current="consultant" />
    <V2ContactCTA variant="consultant" chatHref={FREE_CHAT_URL} />
    <V2Footer />
    <NewsletterFloatingCTA />
  </body>
</html>
