---
// 新版頁首（兩排）：上排品牌＋社群＋ADMIT ONE 票根；下排編號導覽＋NOW PLAYING；手機收合成選單
import { Icon } from 'astro-icon/components';
import { SOCIAL_LINKS } from '../../consts';

interface Props {
  homeHref?: string;
  chatHref: string;
  hall?: string;
}
const { homeHref = '/', chatHref, hall = 'HALL 01' } = Astro.props;

const NAV = [
  { label: '文章', href: '/blog' },
  { label: '關於我', href: '/about' },
  { label: '職涯諮詢與陪跑', href: '/coaching' },
  { label: 'AI 與資料自動化導入', href: '/consultant' },
  { label: '企業內訓與學校講座', href: '/instructor' },
];
const no = (i: number) => String(i + 1).padStart(2, '0');
---

<nav class="nav" aria-label="主選單">
  <div class="marquee-bulbs" aria-hidden="true"></div>
  <div class="wrap nav-in">
    <a class="brand" href={homeHref} aria-label="DayDream Director · Dex 的塵世哲學 首頁">
      <img class="brand-logo" src="/brand/daydream-director-amber.webp" alt="DayDream Director" width="117" height="44" />
      <span class="brand-sep" aria-hidden="true"></span>
      <span><b>Dex 的塵世哲學</b><small>AI &amp; DATA DREAMERS</small></span>
    </a>

    <div class="nav-right">
      <div class="nav-social">
        {SOCIAL_LINKS.map((s) => (
          <a href={s.url} title={s.name} aria-label={s.name} target="_blank" rel="noopener noreferrer">
            <Icon name={s.icon} width={15} height={15} aria-hidden="true" />
          </a>
        ))}
      </div>
      <a class="admit" href={chatHref} target="_blank" rel="noopener noreferrer">
        <span class="admit-stub">ADMIT ONE</span>
        <span class="admit-main">免費聊聊</span>
      </a>
      <details class="nav-menu">
        <summary aria-label="開啟選單">選單</summary>
        <div class="nav-menu-panel">
          {NAV.map((n, i) => <a href={n.href}><span class="nav-no">{no(i)}</span>{n.label}</a>)}
          <div class="nav-menu-social">
            {SOCIAL_LINKS.map((s) => (
              <a href={s.url} aria-label={s.name} target="_blank" rel="noopener noreferrer">
                <Icon name={s.icon} width={18} height={18} aria-hidden="true" />
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
  <div class="nav-row2">
    <div class="wrap nav-row2-in">
      <div class="links">
        {NAV.map((n, i) => <a href={n.href}><span class="nav-no">{no(i)}</span>{n.label}</a>)}
      </div>
      <span class="now-playing">NOW PLAYING · {hall}</span>
    </div>
  </div>
</nav>
