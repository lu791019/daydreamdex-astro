---
// BaseHead.astro — 全站共用的 head 元素（charset、viewport、字型、favicon、sitemap、RSS、generator）
// SEO 部分（title、description、Open Graph、Twitter Card、JSON-LD）改由 SEO.astro 負責
import '../styles/global.css';
import '../styles/rwd.css';
import { SITE_TITLE } from '../consts';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Favicon (webp 為主，svg/ico 作為 fallback) -->
<link rel="icon" type="image/webp" href="/favicon.webp" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<meta name="generator" content={Astro.generator} />

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-J9CMX2NPH8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-J9CMX2NPH8');
</script>

<!-- DNS prefetch for third-party origins -->
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://aapd.simplybook.asia" />

<!--
  字型策略：純 system fonts，不載 Google Fonts
  - macOS/iOS: PingFang TC / Songti TC (預裝、品質高)
  - Windows: Microsoft JhengHei / MingLiU
  - Android: Noto Sans CJK (Android 系統字)
  - Linux: 視發行版

  好處：
  - 省 132 KB unused CSS (Google Fonts 內部 @font-face rules)
  - 省 ~60 KB woff2 字型載入時間
  - 0 ms 字型載入阻塞 → Mobile LCP 大幅改善
  - PSI Mobile Perf 預期 55 → 80+

  Trade-off：
  - 訪客看到的中文字型跟設計稿 Noto Sans TC 有 5–10% 差異
  - 但 fallback chain 已在每個元件的 font-family 內含 PingFang TC / 微軟正黑體
  - 視覺上仍是「無襯線中文字」整體調性不變
-->
