---
// BaseHead.astro — 全站共用的 head 元素（charset、viewport、字型、favicon、sitemap、RSS、generator）
// SEO 部分（title、description、Open Graph、Twitter Card、JSON-LD）改由 SEO.astro 負責
import '../styles/global.css';
import '../styles/rwd.css';
import { SITE_TITLE } from '../consts';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Favicon (webp 為主，svg/ico 作為 fallback) -->
<link rel="icon" type="image/webp" href="/favicon.webp" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" href="/favicon.ico" />

<!-- Sitemap & RSS -->
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL('rss.xml', Astro.site)}
/>

<meta name="generator" content={Astro.generator} />

<!-- Google Analytics 4 -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-J9CMX2NPH8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-J9CMX2NPH8');
</script>

<!-- DNS prefetch for third-party origins -->
<link rel="dns-prefetch" href="https://www.googletagmanager.com" />
<link rel="dns-prefetch" href="https://aapd.simplybook.asia" />

<!-- Fonts: Noto Sans TC + Noto Serif TC (preload CSS to start fetch earlier) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!--
  字型策略：display=optional - 首次訪客 100ms 內沒拿到 fonts 就立刻用 system fallback（PingFang TC / Microsoft JhengHei）
  不阻塞 LCP。fonts 載入後 cache 給下次訪問用。對 Mobile PSI 影響極大。
  讀者第一次可能看到 system fonts (視覺微差) - 但 LCP 從 17s 降到 < 4s 換來的。
-->
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@400;700&display=optional"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@400;700&display=optional"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;700&family=Noto+Serif+TC:wght@400;700&display=optional"
  />
</noscript>
